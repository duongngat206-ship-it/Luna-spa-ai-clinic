@model List<GiaoDienSpa.Controllers.StaffRoomBed>
@{
    ViewData["Title"] = "Trạm Điều Phối & Tác Nghiệp Kỹ Thuật Viên";
    var activeBeds = ViewBag.ActiveBeds ?? 2;
    var readyBeds = ViewBag.ReadyBeds ?? 2;
    var cleaningBeds = ViewBag.CleaningBeds ?? 2;
    var todayGuests = ViewBag.TodayGuests ?? 16;
    var completedGuests = ViewBag.CompletedGuests ?? 8;
    var commission = ViewBag.ShiftCommission ?? "850.000 đ";
}

<div class="staff-dashboard">
    <!-- Header banner ca trực -->
    <div class="card border-0 rounded-4 shadow-sm p-4 mb-4 text-white" style="background: linear-gradient(135deg, #0f766e 0%, #115e59 50%, #134e4a 100%);">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
            <div>
                <div class="d-flex align-items-center gap-2 mb-2">
                    <span class="badge bg-white text-dark fw-bold px-3 py-1 rounded-pill shadow-sm">
                        <i class="fas fa-id-badge text-teal me-1"></i> @ViewBag.StaffRole
                    </span>
                    <span class="badge bg-emerald text-white rounded-pill px-3 py-1">
                        <span class="bed-status-pulse active me-1"></span> Ca trực: 08:30 – 18:30 (Đang hoạt động)
                    </span>
                </div>
                <h3 class="fw-bold mb-1">Xin chào, KTV. @ViewBag.StaffName</h3>
                <p class="mb-0 text-white-50">Trung tâm điều phối buồng phòng trị liệu, tiếp đón khách hàng và vận hành phác đồ chuẩn y khoa</p>
            </div>
            <div class="d-flex flex-wrap gap-2">
                <a href="/Staff/CheckIn" class="btn btn-warning fw-bold px-4 py-2 rounded-pill shadow-sm text-dark">
                    <i class="fas fa-user-check me-1"></i> Tiếp Đón Check-In
                </a>
                <a href="/Staff/Appointments" class="btn btn-outline-light fw-semibold px-3 py-2 rounded-pill">
                    <i class="fas fa-tasks me-1"></i> Lịch Ca Trực
                </a>
                <a href="/Staff/POS" class="btn btn-outline-light fw-semibold px-3 py-2 rounded-pill">
                    <i class="fas fa-cash-register me-1"></i> Thu Ngân POS
                </a>
                <a href="/Staff/Supplies" class="btn btn-outline-light fw-semibold px-3 py-2 rounded-pill">
                    <i class="fas fa-boxes me-1"></i> Kho Vật Tư
                </a>
            </div>
        </div>
    </div>

    <!-- 4 Khối thống kê KPI ca trực chuyên nghiệp -->
    <div class="row g-3 mb-4">
        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 rounded-4 shadow-sm p-4 bg-white h-100 hover-shadow border-start border-4 border-success">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-muted small fw-bold text-uppercase">Giường Đang Phục Vụ</div>
                        <h2 class="fw-bold text-success mb-0 mt-2">@activeBeds <span class="fs-6 text-muted fw-normal">/ @Model.Count phòng</span></h2>
                        <div class="small text-muted mt-2"><i class="fas fa-procedures text-success me-1"></i> Khách đang trị liệu</div>
                    </div>
                    <div class="rounded-4 p-3 bg-success bg-opacity-10 text-success fs-3">
                        <i class="fas fa-bed"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 rounded-4 shadow-sm p-4 bg-white h-100 hover-shadow border-start border-4 border-primary">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-muted small fw-bold text-uppercase">Giường Sẵn Sàng</div>
                        <h2 class="fw-bold text-primary mb-0 mt-2">@readyBeds <span class="fs-6 text-muted fw-normal">phòng</span></h2>
                        <div class="small text-muted mt-2"><i class="fas fa-check-circle text-primary me-1"></i> Đã vô trùng đón khách</div>
                    </div>
                    <div class="rounded-4 p-3 bg-primary bg-opacity-10 text-primary fs-3">
                        <i class="fas fa-door-open"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 rounded-4 shadow-sm p-4 bg-white h-100 hover-shadow border-start border-4 border-warning">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-muted small fw-bold text-uppercase">Khách Tiếp Đón Hôm Nay</div>
                        <h2 class="fw-bold text-dark mb-0 mt-2">@todayGuests <span class="fs-6 text-success fw-semibold">(@completedGuests xong)</span></h2>
                        <div class="small text-muted mt-2"><i class="fas fa-chart-line text-warning me-1"></i> Tiến độ ca đạt: 50%</div>
                    </div>
                    <div class="rounded-4 p-3 bg-warning bg-opacity-10 text-warning fs-3">
                        <i class="fas fa-users"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 rounded-4 shadow-sm p-4 bg-white h-100 hover-shadow border-start border-4 border-teal">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-muted small fw-bold text-uppercase">Hoa Hồng Ca Của Bạn</div>
                        <h2 class="fw-bold text-teal mb-0 mt-2">@commission</h2>
                        <div class="small text-muted mt-2"><i class="fas fa-star text-warning me-1"></i> Đánh giá KTV: <strong>4.95 / 5★</strong></div>
                    </div>
                    <div class="rounded-4 p-3 bg-teal bg-opacity-10 text-teal fs-3">
                        <i class="fas fa-award"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Sơ đồ buồng phòng trị liệu thời gian thực (Interactive Floor Plan & Bed Grid) -->
    <div class="card border-0 rounded-4 shadow-sm p-4 mb-4 bg-white">
        <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
            <div>
                <h5 class="fw-bold mb-1 text-dark"><i class="fas fa-th-large text-teal me-2"></i> Bản Đồ Buồng Phòng & Giường Trị Liệu Trực Quan</h5>
                <p class="text-muted small mb-0">Theo dõi thời gian thực tiến trình của từng khách hàng và điều phối buồng phòng nhanh chóng</p>
            </div>
            <div class="d-flex flex-wrap gap-2">
                <span class="badge bg-success text-white px-3 py-1 rounded-pill small">● Đang phục vụ</span>
                <span class="badge bg-primary text-white px-3 py-1 rounded-pill small">● Sẵn sàng</span>
                <span class="badge bg-warning text-dark px-3 py-1 rounded-pill small">● Chờ khách</span>
                <span class="badge bg-secondary text-white px-3 py-1 rounded-pill small">● Đang vô trùng</span>
            </div>
        </div>

        <div class="row g-3">
            @foreach (var room in Model)
            {
                var badgeClass = room.Status switch
                {
                    "Đang phục vụ" => "bg-success text-white",
                    "Sẵn sàng" => "bg-primary text-white",
                    "Chờ khách vào" => "bg-warning text-dark",
                    "Đang vô trùng" => "bg-secondary text-white",
                    _ => "bg-light text-dark"
                };

                var borderClass = room.Status switch
                {
                    "Đang phục vụ" => "border-success",
                    "Sẵn sàng" => "border-primary",
                    "Chờ khách vào" => "border-warning",
                    "Đang vô trùng" => "border-secondary",
                    _ => "border-light"
                };

                var progressPct = room.DurationMinutes > 0 ? (int)((double)room.ElapsedMinutes / room.DurationMinutes * 100) : 0;
                if (progressPct > 100) progressPct = 100;

                <div class="col-md-6 col-lg-4">
                    <div class="card h-100 rounded-4 border-2 @borderClass p-3 shadow-none position-relative" style="background: #fafaf9;">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="badge @badgeClass rounded-pill px-3 py-1 small fw-bold">
                                @if (room.Status == "Đang phục vụ")
                                {
                                    <span class="bed-status-pulse active me-1"></span>
                                }
                                @room.Status
                            </span>
                            <span class="fw-bold text-dark font-monospace bg-white px-2 py-1 rounded border shadow-sm">@room.BedCode</span>
                        </div>

                        <h6 class="fw-bold text-dark mb-1">@room.RoomName</h6>

                        <div class="my-2 p-3 rounded-3 bg-white small border">
                            <div class="text-muted mb-1"><i class="fas fa-user text-primary me-1"></i> Khách: <strong class="text-dark">@room.CustomerName</strong></div>
                            <div class="text-muted mb-1"><i class="fas fa-spa text-teal me-1"></i> Dịch vụ: <span class="text-teal fw-semibold">@room.ServiceName</span></div>
                            <div class="d-flex justify-content-between text-muted mb-1">
                                <span><i class="fas fa-clock text-warning me-1"></i> Vào: @room.StartTime</span>
                                <span><i class="fas fa-hourglass-half text-info me-1"></i> @room.ElapsedMinutes / @room.DurationMinutes phút</span>
                            </div>

                            @if (room.Status == "Đang phục vụ")
                            {
                                <div class="mt-2">
                                    <div class="progress rounded-pill" style="height: 6px;">
                                        <div class="progress-bar bg-teal progress-bar-striped progress-bar-animated" style="width: @progressPct%"></div>
                                    </div>
                                </div>
                            }
                        </div>

                        @if (!string.IsNullOrEmpty(room.Notes))
                        {
                            <div class="small text-muted mb-3 fst-italic">
                                <i class="fas fa-info-circle text-teal me-1"></i> @room.Notes
                            </div>
                        }

                        <div class="mt-auto pt-2 border-top d-flex justify-content-between align-items-center small">
                            <span class="text-muted"><i class="fas fa-user-nurse me-1"></i> @room.AssignedStaff</span>
                            <div class="d-flex gap-1">
                                @if (room.Status == "Sẵn sàng")
                                {
                                    <a href="/Staff/CheckIn?roomId=@room.RoomId" class="btn btn-sm btn-primary rounded-pill px-3 fw-semibold">
                                        <i class="fas fa-user-plus me-1"></i> Đón khách
                                    </a>
                                }
                                else if (room.Status == "Đang phục vụ")
                                {
                                    <button class="btn btn-sm btn-success rounded-pill px-3 fw-semibold" onclick="updateBedStatus(@room.RoomId, 'Đang vô trùng')">
                                        <i class="fas fa-check me-1"></i> Hoàn tất ca
                                    </button>
                                }
                                else if (room.Status == "Đang vô trùng")
                                {
                                    <button class="btn btn-sm btn-outline-primary rounded-pill px-3 fw-semibold" onclick="updateBedStatus(@room.RoomId, 'Sẵn sàng')">
                                        <i class="fas fa-spray-can me-1"></i> Đã sạch xong
                                    </button>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>

    <!-- Hàng dưới: Lịch chăm sóc hôm nay & Trợ lý vật tư AI -->
    <div class="row g-4">
        <div class="col-lg-7">
            <div class="card border-0 rounded-4 shadow-sm p-4 bg-white h-100">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="fw-bold mb-0 text-dark"><i class="fas fa-tasks text-teal me-2"></i> Ca Chăm Sóc Hôm Nay Của Bạn</h5>
                    <a href="/Staff/Appointments" class="btn btn-sm btn-link text-teal text-decoration-none fw-bold">Chi tiết ca <i class="fas fa-arrow-right ms-1"></i></a>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Thời gian</th>
                                <th>Khách hàng</th>
                                <th>Dịch vụ</th>
                                <th>Phòng</th>
                                <th>Trạng thái</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td class="fw-bold text-teal">09:00 - 10:15</td>
                                <td>
                                    <div class="fw-bold">Nguyễn Thị Minh Anh</div>
                                    <div class="small text-muted">0912.334.556</div>
                                </td>
                                <td>Laser Pico Pro Trị Tàn Nhang</td>
                                <td><span class="badge bg-light text-dark border">P.Laser 01</span></td>
                                <td><span class="badge bg-success text-white rounded-pill px-3 py-1">Đang làm</span></td>
                            </tr>
                            <tr>
                                <td class="fw-bold text-teal">11:00 - 12:00</td>
                                <td>
                                    <div class="fw-bold">Trần Thu Hà</div>
                                    <div class="small text-muted">0988.221.119</div>
                                </td>
                                <td>Aqua Detox Cấp Ẩm Chuyên Sâu</td>
                                <td><span class="badge bg-light text-dark border">P.VIP 01</span></td>
                                <td><span class="badge bg-success text-white rounded-pill px-3 py-1">Đang làm</span></td>
                            </tr>
                            <tr>
                                <td class="fw-bold text-teal">14:00 - 15:30</td>
                                <td>
                                    <div class="fw-bold">Vũ Bích Ngọc</div>
                                    <div class="small text-muted">0977.882.334</div>
                                </td>
                                <td>Nâng Cơ Trẻ Hóa Hifu Collagen</td>
                                <td><span class="badge bg-light text-dark border">P.Hifu VIP</span></td>
                                <td><span class="badge bg-warning text-dark rounded-pill px-3 py-1">Sắp tới</span></td>
                            </tr>
                            <tr>
                                <td class="fw-bold text-teal">16:30 - 17:30</td>
                                <td>
                                    <div class="fw-bold">Lê Phương Thảo</div>
                                    <div class="small text-muted">0903.445.667</div>
                                </td>
                                <td>Cấp Ẩm HA Đa Tầng</td>
                                <td><span class="badge bg-light text-dark border">P.Chăm Sóc 01</span></td>
                                <td><span class="badge bg-secondary text-white rounded-pill px-3 py-1">Chưa đến</span></td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="col-lg-5">
            <div class="card border-0 rounded-4 shadow-sm p-4 bg-white h-100">
                <h5 class="fw-bold mb-3 text-dark"><i class="fas fa-robot text-teal me-2"></i> Trợ Lý Vật Tư & Kỹ Thuật AI</h5>
                <div class="p-3 rounded-4 mb-3" style="background: #f0fdf4; border: 1px solid #bbf7d0;">
                    <div class="d-flex gap-3">
                        <div class="fs-3 text-success"><i class="fas fa-sparkles"></i></div>
                        <div>
                            <div class="fw-bold text-success">Gợi ý chuẩn bị cho ca Hifu 14:00</div>
                            <div class="small text-dark mt-1">
                                Khách hàng <strong>Vũ Bích Ngọc</strong> có da nhạy cảm nhẹ sau quét AI. Khuyến nghị chuẩn bị:
                                <ul class="mb-0 ps-3 mt-1">
                                    <li>Gel dẫn sóng Hifu vô trùng lạnh (100ml)</li>
                                    <li>Đầu Tip Hifu 3.0mm và 4.5mm đã khử khuẩn UV</li>
                                    <li>Mặt nạ phục hồi Tế Bào Gốc làm dịu ngay sau bắn</li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>

                <h6 class="fw-bold text-dark mt-3 mb-2">Thao tác tác nghiệp nhanh</h6>
                <div class="d-grid gap-2">
                    <a href="/Staff/CheckIn" class="btn btn-outline-teal text-start rounded-3 py-2 fw-semibold">
                        <i class="fas fa-qrcode me-2"></i> Quét mã QR Thẻ Khách / Đón khách
                    </a>
                    <a href="/Staff/POS" class="btn btn-outline-dark text-start rounded-3 py-2 fw-semibold">
                        <i class="fas fa-barcode me-2"></i> Xuất vật tư & Thu ngân POS
                    </a>
                    <a href="/Staff/Supplies" class="btn btn-outline-secondary text-start rounded-3 py-2 fw-semibold">
                        <i class="fas fa-boxes me-2"></i> Báo cáo & Yêu cầu cấp vật tư tiêu hao
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
async function updateBedStatus(roomId, newStatus) {
    try {
        const res = await fetch('/Staff/UpdateBedStatus', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ roomId: roomId, newStatus: newStatus })
        });
        const data = await res.json();
        if (data.success) {
            alert(data.message);
            location.reload();
        } else {
            alert(data.message || 'Lỗi cập nhật');
        }
    } catch(err) {
        console.error(err);
        alert('Lỗi kết nối máy chủ');
    }
}
</script>
