    <!-- JAVASCRIPT ĐIỀU KHIỂN CHAT BOX AI NỔI TOÀN CỤC -->
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const trigger = document.getElementById("lunaChatTrigger");
            const popover = document.getElementById("lunaChatPopover");
            const tooltip = document.getElementById("lunaChatTooltip");
            const badge = document.getElementById("lunaChatBadge");
            const closeBtn = document.getElementById("lunaChatCloseBtn");
            const minBtn = document.getElementById("lunaChatMinimizeBtn");
            const chatBody = document.getElementById("lunaGlobalChatBody");
            const form = document.getElementById("lunaGlobalChatForm");
            const input = document.getElementById("lunaGlobalChatInput");
            const chips = document.getElementById("lunaGlobalChips");

            if (!trigger || !popover) return;

            function togglePopover() {
                const isCollapsed = popover.classList.contains("collapsed");
                if (isCollapsed) {
                    popover.classList.remove("collapsed");
                    if (tooltip) tooltip.style.display = "none";
                    if (badge) badge.style.display = "none";
                    setTimeout(() => input?.focus(), 200);
                } else {
                    popover.classList.add("collapsed");
                }
            }

            trigger.addEventListener("click", togglePopover);
            if (closeBtn) closeBtn.addEventListener("click", () => popover.classList.add("collapsed"));
            if (minBtn) minBtn.addEventListener("click", () => popover.classList.add("collapsed"));

            function escapeHtml(text) {
                if (!text) return "";
                const div = document.createElement("div");
                div.textContent = text;
                return div.innerHTML;
            }

            async function sendGlobalMessage(msgText) {
                if (!msgText || !msgText.trim()) return;

                const timeStr = new Date().toLocaleTimeString("vi-VN", { hour: "2-digit", minute: "2-digit" });

                // Hiển thị tin nhắn của người dùng
                const userWrap = document.createElement("div");
                userWrap.className = "luna-msg-wrap user";
                userWrap.innerHTML = `
                    <div class="luna-bubble-user">${escapeHtml(msgText)}</div>
                    <span class="luna-msg-time">${timeStr}</span>
                `;
                chatBody.appendChild(userWrap);
                if (input) input.value = "";
                chatBody.scrollTop = chatBody.scrollHeight;

                // Hiển thị hiệu ứng AI đang soạn câu trả lời (typing dots)
                const typingWrap = document.createElement("div");
                typingWrap.className = "luna-msg-wrap ai";
                typingWrap.id = "lunaGlobalTyping";
                typingWrap.innerHTML = `
                    <div class="luna-typing-dots">
                        <span></span><span></span><span></span>
                    </div>
                `;
                chatBody.appendChild(typingWrap);
                chatBody.scrollTop = chatBody.scrollHeight;

                try {
                    const response = await fetch("/AI/SendChat", {
                        method: "POST",
                        headers: { "Content-Type": "application/json" },
                        body: JSON.stringify({ Message: msgText })
                    });

                    const res = await response.json();
                    typingWrap.remove();

                    if (res && res.success) {
                        const formattedReply = (res.reply || "")
                            .replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>')
                            .replace(/\n/g, '<br />');

                        const aiWrap = document.createElement("div");
                        aiWrap.className = "luna-msg-wrap ai";
                        aiWrap.innerHTML = `
                            <div class="luna-bubble-ai">${formattedReply}</div>
                            <span class="luna-msg-time">${timeStr}</span>
                        `;
                        chatBody.appendChild(aiWrap);

                        // Cập nhật câu hỏi gợi ý mới từ Luna AI
                        if (res.suggestedChips && res.suggestedChips.length > 0 && chips) {
                            chips.innerHTML = res.suggestedChips.map(c => `
                                <button type="button" class="luna-mini-chip" data-q="${escapeHtml(c)}">
                                    ✦ ${escapeHtml(c)}
                                </button>
                            `).join("");
                            attachMiniChips();
                        }
                    } else {
                        const errWrap = document.createElement("div");
                        errWrap.className = "luna-msg-wrap ai";
                        errWrap.innerHTML = `<div class="luna-bubble-ai" style="color: #b91c1c;">Hệ thống tư vấn đang bận. Quý khách vui lòng thử lại sau giây lát!</div>`;
                        chatBody.appendChild(errWrap);
                    }
                } catch (err) {
                    typingWrap.remove();
                    console.error("Lỗi gửi tin nhắn AI:", err);
                    const errWrap = document.createElement("div");
                    errWrap.className = "luna-msg-wrap ai";
                    errWrap.innerHTML = `<div class="luna-bubble-ai" style="color: #b91c1c;">Không thể kết nối đến máy chủ AI. Vui lòng kiểm tra lại đường truyền mạng.</div>`;
                    chatBody.appendChild(errWrap);
                }

                chatBody.scrollTop = chatBody.scrollHeight;
            }

            if (form) {
                form.addEventListener("submit", function (e) {
                    e.preventDefault();
                    if (input) sendGlobalMessage(input.value);
                });
            }

            function attachMiniChips() {
                document.querySelectorAll(".luna-mini-chip").forEach(chip => {
                    chip.onclick = function () {
                        const q = this.getAttribute("data-q");
                        sendGlobalMessage(q);
                    };
                });
            }

            attachMiniChips();
        });
    </script>

    <!-- BOOTSTRAP 5.3 BUNDLE JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

