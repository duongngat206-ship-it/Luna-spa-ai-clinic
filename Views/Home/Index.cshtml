@section Scripts {
<script>
    // XỬ LÝ CHẨN ĐOÁN DA AI NHANH TRÊN TRANG CHỦ
    const tagBtns = document.querySelectorAll("#aiConcernSelector .portal-tag-btn");
    let currentConcern = "Lỗ chân lông to & Dầu thừa";

    tagBtns.forEach(btn => {
        btn.addEventListener("click", function() {
            tagBtns.forEach(b => b.classList.remove("active"));
            this.classList.add("active");
            currentConcern = this.getAttribute("data-val");
        });
    });

    document.getElementById("btnRunAiDiagnosis")?.addEventListener("click", function() {
        const age = parseInt(document.getElementById("aiQuickAge").value);
        const skinType = document.getElementById("aiQuickSkinType").value;
        const btn = this;

        btn.innerHTML = `<span>⏳</span> Đang quét quang phổ AI...`;
        btn.disabled = true;

        setTimeout(() => {
            let score = 82;
            let diagnosisText = "";
            let serviceText = "";
            let cosmeticText = "";

            if (currentConcern.includes("Mụn") || skinType.includes("mụn")) {
                score = 68;
                diagnosisText = `AI phát hiện bít tắc nang lông và bã nhờn tầng nông. Mật độ khuẩn mụn tăng 24% kèm phản ứng viêm đỏ biểu bì.`;
                serviceText = "Trị mụn y khoa vi sinh Acnes Clear & Chiếu ánh sáng Bio-Light";
                cosmeticText = "Gel rửa mặt BHA La Roche-Posay + Serum B5 HA Intensifier + Kẽm sinh học";
            } else if (currentConcern.includes("Nám") || currentConcern.includes("Tàn nhang")) {
                score = 71;
                diagnosisText = `Mật độ Melanin tăng tích tụ tại vùng gò má do tiếp xúc UV. Hàng rào Ceramide mỏng cần được tái tạo màng đáy.`;
                serviceText = "Trẻ hóa da Laser Pico Pro (75p) + Điện di Tế bào gốc Phục hồi Màng đáy";
                cosmeticText = "Serum Vitamin C-Glow 15% + Kem dưỡng Tranexamic 3% + KCN Phổ rộng SPF50+";
            } else if (currentConcern.includes("Chùng nhão") || age >= 36) {
                score = 66;
                diagnosisText = `Độ dày lớp trung bì suy giảm, mạng lưới collagen và elastin bắt đầu phân mảnh. Cần can thiệp săn chắc viền hàm.`;
                serviceText = "Nâng cơ trẻ hóa Hifu Ultra Collagen (90p) + Cấy vi điểm Collagen Tươi";
                cosmeticText = "Kem nâng cơ Peptides + Serum Retinol 0.5% + Mặt nạ thủy phân tái sinh";
            } else {
                score = 85;
                diagnosisText = `Làn da ở trạng thái ổn định tương đối tốt. Cần cấp ẩm tầng sâu và thanh lọc bụi mịn để duy trì vẻ rạng rỡ tự nhiên.`;
                serviceText = "Chăm sóc da chuyên sâu Aqua Detox (60p) + Điện di Vitamin C sáng da";
                cosmeticText = "Serum B5 HA Intensifier + Xịt khoáng núi lửa + Kem dưỡng ẩm mỏng nhẹ";
            }

            document.getElementById("resultScore").innerText = `${score} / 100`;
            document.getElementById("resultText").innerText = diagnosisText;
            document.getElementById("resultService").innerText = serviceText;
            document.getElementById("resultCosmetic").innerText = cosmeticText;
            document.getElementById("resultTimestamp").innerText = `Thời gian: ${new Date().toLocaleTimeString('vi-VN')}`;

            btn.innerHTML = `<span>✓</span> Đã Phân Tích Xong!`;
            btn.disabled = false;

            if (window.showLunaToast) {
                window.showLunaToast(`✨ AI đã hoàn thành chẩn đoán da! Điểm sức khỏe: ${score}/100.`, "success");
            }
        }, 800);
    });

    document.getElementById("btnBookFromAiResult")?.addEventListener("click", function() {
        const service = document.getElementById("resultService").innerText;
        document.getElementById("bookCustService").value = "Khám da & Tư vấn phác đồ AI Miễn phí";
        document.getElementById("bookCustNote").value = `Tôi muốn đăng ký phác đồ AI đề xuất: ${service}`;
        document.getElementById("bookingSection").scrollIntoView({ behavior: 'smooth' });
    });

    // NÚT ĐẶT LỊCH TRỰC TIẾP TỪ THẺ DỊCH VỤ
    document.querySelectorAll(".btn-book-service").forEach(btn => {
        btn.addEventListener("click", function() {
            const serviceName = this.getAttribute("data-service");
            const selectElem = document.getElementById("bookCustService");
            
            // Tìm option tương ứng hoặc chọn mặc định
            let found = false;
            for (let opt of selectElem.options) {
                if (opt.text.includes(serviceName) || opt.value.includes(serviceName)) {
                    opt.selected = true;
                    found = true;
                    break;
                }
            }
            if (!found) {
                document.getElementById("bookCustNote").value = `Tôi muốn đăng ký dịch vụ: ${serviceName}`;
            }

            document.getElementById("bookingSection").scrollIntoView({ behavior: 'smooth' });
            document.getElementById("bookCustName").focus();
        });
    });

    // XỬ LÝ GỬI FORM ĐẶT LỊCH TRỰC TUYẾN
    document.getElementById("btnSubmitPublicBooking")?.addEventListener("click", async function() {
        const name = document.getElementById("bookCustName").value.trim();
        const phone = document.getElementById("bookCustPhone").value.trim();
        const service = document.getElementById("bookCustService").value;
        const time = document.getElementById("bookCustTime").value;
        const note = document.getElementById("bookCustNote").value.trim();

        if (!name || !phone) {
            alert("Vui lòng nhập đầy đủ Họ tên và Số điện thoại liên hệ!");
            return;
        }

        const btn = this;
        btn.innerHTML = `<span>⏳</span> Đang gửi thông tin...`;
        btn.disabled = true;

        try {
            const resp = await fetch("/Home/BookConsultation", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({
                    CustomerName: name,
                    Phone: phone,
                    ServiceName: service,
                    PreferredTime: time,
                    Note: note
                })
            });

            const data = await resp.json();
            if (data.success) {
                alert(`✓ Đăng ký thành công!\nMã lịch hẹn: ${data.appointmentCode}\nChuyên viên LUNA SPA sẽ gọi lại cho bạn qua SĐT ${phone} trong ít phút.`);
                document.getElementById("bookCustName").value = "";
                document.getElementById("bookCustPhone").value = "";
                document.getElementById("bookCustNote").value = "";
                if (window.showLunaToast) {
                    window.showLunaToast(`✓ Đặt lịch hẹn ${data.appointmentCode} thành công!`, "success");
                }
            } else {
                alert(data.message || "Không thể gửi đăng ký. Vui lòng thử lại!");
            }
        } catch (err) {
            console.error("Booking error:", err);
            alert("Đã xảy ra lỗi khi gửi dữ liệu. Vui lòng gọi Hotline 1900 888 999!");
        } finally {
            btn.innerHTML = `<span>✓</span> Xác Nhận Đăng Ký Lịch Hẹn`;
            btn.disabled = false;
        }
    });
</script>
}