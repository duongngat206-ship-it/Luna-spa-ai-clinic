@{
    var currentCtrl = ViewContext.RouteData.Values["controller"]?.ToString() ?? "Home";
    var currentAct = ViewContext.RouteData.Values["action"]?.ToString() ?? "Index";
    bool isPublicPortal = (currentCtrl == "Home" && currentAct == "Index") || (ViewBag.IsPublicPage == true);

    var userName = Context.Session.GetString("UserName");
    var userEmail = Context.Session.GetString("UserEmail");
    var userRole = Context.Session.GetString("UserRole");
    var userRoleTitle = Context.Session.GetString("UserRoleTitle") ?? "Khách hàng Thân thiết";
    var userAvatar = Context.Session.GetString("UserAvatarInitials") ?? "KH";
    var userColor = Context.Session.GetString("UserAvatarColor") ?? "#a76d8e";
    bool isLoggedIn = !string.IsNullOrEmpty(userName);
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - LUNA SPA & AI CLINIC</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Playfair+Display:ital,wght@0,600;0,700;1,600&display=swap" rel="stylesheet">
    
    <!-- BOOTSTRAP 5.3 & FONT AWESOME 6 ICONS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="@(isPublicPortal ? "public-portal-body" : "admin-layout-body")">

@if (isPublicPortal)
{
    <!-- HEADER TRANG CHỦ CÔNG KHAI -->
    <header class="portal-main-header">
        <!-- TOP ANNOUNCEMENT BAR -->
        <!-- TOP ANNOUNCEMENT BAR & QUICK ROLE ACCESS -->
        <div class="portal-top-bar">
            <div class="portal-container portal-top-bar-inner">
                <div class="top-bar-left">
                    <span>📞 Hotline 24/7: <strong>1900 888 999</strong></span>
                    <span class="bar-sep">•</span>
                    <span>⏰ 08:30 – 21:00</span>
                    <span class="bar-sep">•</span>
                    <span>📍 123 Nguyễn Huệ, Quận 1, TP. HCM</span>
                </div>
                <div class="top-bar-right">
                    @if (!isLoggedIn)
                    {
                        <div class="top-bar-quick-roles">
                            <span class="quick-title">⚡ Đăng nhập nhanh 1-Click:</span>
                            <button type="button" class="quick-role-badge btn-demo-quick" data-role="Admin" title="Đăng nhập Quản trị viên">
                                🛡️ Admin
                            </button>
                            <button type="button" class="quick-role-badge btn-demo-quick" data-role="Doctor" title="Đăng nhập Bác sĩ chuyên khoa">
                                🩺 Bác sĩ
                            </button>
                            <button type="button" class="quick-role-badge btn-demo-quick" data-role="Staff" title="Đăng nhập Nhân viên (Kỹ thuật viên)">
                                💆 Nhân viên
                            </button>
                            <button type="button" class="quick-role-badge btn-demo-quick" data-role="Customer" title="Đăng nhập Khách hàng VIP">
                                👤 Khách hàng
                            </button>
                        </div>
                    }
                    else
                    {
                        <span class="ai-live-tag">✨ AI Online: Đang hỗ trợ chẩn đoán da</span>
                    }
                </div>
            </div>
        </div>

        <!-- MAIN NAVBAR -->
        <nav class="portal-navbar">
            <div class="portal-container portal-navbar-inner">
                <a asp-controller="Home" asp-action="Index" class="portal-brand">
                    <div class="portal-brand-logo">✿</div>
                    <div class="portal-brand-text">
                        <strong>LUNA SPA</strong>
                        <small>AI Clinic & Luxury Care</small>
                    </div>
                </a>

                <div class="portal-nav-links">
                    <a asp-controller="Home" asp-action="Index" class="nav-link @(currentCtrl == "Home" && currentAct == "Index" ? "active" : "")">Trang chủ</a>
                    <a href="/Home/Index#servicesSection" class="nav-link">Dịch vụ Spa</a>
                    <a href="/Home/Index#aiHighlightsSection" class="nav-link">Công nghệ AI</a>
                    <a href="/Home/Index#aiExperienceSection" class="nav-link">Soi da AI</a>
                    <a asp-controller="AI" asp-action="Index" class="nav-link @(currentCtrl == "AI" ? "active" : "")">Tư vấn AI</a>
                    <a asp-controller="Reports" asp-action="Index" class="nav-link @(currentCtrl == "Reports" ? "active" : "")">Báo cáo</a>
                    <a href="/Home/Index#bookingSection" class="nav-link">Đặt lịch hẹn</a>
                </div>

                <div class="portal-nav-auth">
                    @if (!isLoggedIn)
                    {
                        <button type="button" class="portal-auth-btn btn-ghost open-auth-modal-btn" data-mode="login">
                            <span>🔑</span> Đăng nhập
                        </button>
                        <button type="button" class="portal-auth-btn btn-solid open-auth-modal-btn" data-mode="register">
                            <span>✦</span> Đăng ký
                        </button>
                    }
                    else
                    {
                        <div class="portal-user-badge open-user-profile-btn" id="portalUserProfileBtn" role="button" tabindex="0" title="Bấm để xem và chỉnh sửa hồ sơ cá nhân">
                            <div class="portal-user-avatar" id="portalUserAvatar" style="background: @userColor;">@userAvatar</div>
                            <div class="portal-user-info">
                                <strong id="portalUserName">@userName <span style="font-size: 11px; opacity: 0.7;">✏️</span></strong>
                                <span class="badge-role-pill" id="portalUserRole">@userRoleTitle</span>
                            </div>
                        </div>

                        @if (userRole == "Admin")
                        {
                            <a href="/Admin/Dashboard" class="portal-auth-btn btn-dashboard">
                                <span>🛡️</span> Cổng Quản Trị
                            </a>
                        }
                        else if (userRole == "Doctor")
                        {
                            <a href="/Doctor/Dashboard" class="portal-auth-btn btn-dashboard" style="background: linear-gradient(135deg, #0284c7, #0369a1); color: white;">
                                <span>🩺</span> Bàn Bác Sĩ
                            </a>
                        }
                        else if (userRole == "Staff")
                        {
                            <a href="/Staff/Dashboard" class="portal-auth-btn btn-dashboard" style="background: linear-gradient(135deg, #0d9488, #0f766e); color: white;">
                                <span>💆</span> Trạm KTV
                            </a>
                        }
                        else if (userRole == "Customer")
                        {
                            <a href="/CustomerPortal/Index" class="portal-auth-btn btn-dashboard" style="background: linear-gradient(135deg, #d97706, #b45309); color: white;">
                                <span>👑</span> Cổng Hội Viên VIP
                            </a>
                        }

                        <button type="button" class="portal-auth-btn btn-logout open-logout-btn" title="Đăng xuất tài khoản">
                            <span>⎋</span> Đăng xuất
                        </button>
                    }
                </div>
            </div>
        </nav>
    </header>

    <!-- MAIN BODY CỦA PUBLIC PORTAL -->
    <main class="portal-body-wrapper">
        @RenderBody()
    </main>
}
else
{
    <!-- LAYOUT BẢNG QUẢN TRỊ NỘI BỘ (ADMIN, DOCTOR, STAFF, CUSTOMER) -->
    <div class="spa-layout">

        <aside class="spa-sidebar">
            <div class="spa-brand">
                <div class="spa-logo">✿</div>
                <div>
                    <strong>LUNA SPA</strong>
                    <small>Management System</small>
                </div>
            </div>

            @if (userRole == "Doctor")
            {
                <div class="spa-menu-title">BÁC SĨ CHUYÊN KHOA</div>

                <nav class="spa-menu">
                    <a asp-controller="Home" asp-action="Index" class="spa-menu-link">
                        <span>🌐</span> Trang chủ công khai
                    </a>

                    <a href="/Doctor/Dashboard" class="spa-menu-link @(currentCtrl == "Doctor" && currentAct == "Dashboard" ? "active" : "")">
                        <span>🩺</span> Bàn làm việc Bác sĩ
                    </a>

                    <a href="/Doctor/AiDiagnosis" class="spa-menu-link @(currentCtrl == "Doctor" && currentAct == "AiDiagnosis" ? "active" : "")">
                        <span>🔬</span> Chẩn đoán hình ảnh AI
                    </a>

                    <a href="/Doctor/Treatments" class="spa-menu-link @(currentCtrl == "Doctor" && currentAct == "Treatments" ? "active" : "")">
                        <span>📋</span> Phác đồ Laser & Da liễu
                    </a>

                    <a href="/Doctor/Patients" class="spa-menu-link @(currentCtrl == "Doctor" && currentAct == "Patients" ? "active" : "")">
                        <span>👥</span> Bệnh án điện tử
                    </a>

                    <a asp-controller="Appointments" asp-action="Index" class="spa-menu-link @(currentCtrl == "Appointments" ? "active" : "")">
                        <span>▣</span> Lịch khám lâm sàng
                    </a>

                    <a asp-controller="AI" asp-action="Index" class="spa-menu-link @(currentCtrl == "AI" ? "active" : "")">
                        <span>✦</span> Trợ lý Luna AI Clinic
                    </a>
                </nav>
            }
            else if (userRole == "Staff")
            {
                <div class="spa-menu-title">KỸ THUẬT VIÊN & LỄ TÂN</div>

                <nav class="spa-menu">
                    <a asp-controller="Home" asp-action="Index" class="spa-menu-link">
                        <span>🌐</span> Trang chủ công khai
                    </a>

                    <a href="/Staff/Dashboard" class="spa-menu-link @(currentCtrl == "Staff" && currentAct == "Dashboard" ? "active" : "")">
                        <span>💆</span> Trạm tác nghiệp KTV
                    </a>

                    <a href="/Staff/CheckIn" class="spa-menu-link @(currentCtrl == "Staff" && currentAct == "CheckIn" ? "active" : "")">
                        <span>🛎️</span> Tiếp đón Check-In
                    </a>

                    <a href="/Staff/Appointments" class="spa-menu-link @(currentCtrl == "Staff" && currentAct == "Appointments" ? "active" : "")">
                        <span>📅</span> Lịch ca phục vụ
                    </a>

                    <a href="/Staff/POS" class="spa-menu-link @(currentCtrl == "Staff" && currentAct == "POS" ? "active" : "")">
                        <span>🛒</span> Thu ngân POS & Mỹ phẩm
                    </a>

                    <a href="/Staff/Supplies" class="spa-menu-link @(currentCtrl == "Staff" && currentAct == "Supplies" ? "active" : "")">
                        <span>📦</span> Kho vật tư buồng phòng
                    </a>

                    <a asp-controller="Inventory" asp-action="Index" class="spa-menu-link @(currentCtrl == "Inventory" ? "active" : "")">
                        <span>▤</span> Kho tổng viện thẩm mỹ
                    </a>

                    <a asp-controller="AI" asp-action="Index" class="spa-menu-link @(currentCtrl == "AI" ? "active" : "")">
                        <span>✦</span> Trợ lý Luna AI
                    </a>
                </nav>
            }
            else if (userRole == "Customer")
            {
                <div class="spa-menu-title">CỔNG HỘI VIÊN VIP</div>

                <nav class="spa-menu">
                    <a asp-controller="Home" asp-action="Index" class="spa-menu-link">
                        <span>🌐</span> Trang chủ công khai
                    </a>

                    <a href="/CustomerPortal/Index" class="spa-menu-link @(currentCtrl == "CustomerPortal" && currentAct == "Index" ? "active" : "")">
                        <span>👑</span> Cổng Hội Viên VIP
                    </a>

                    <a href="/CustomerPortal/Appointments" class="spa-menu-link @(currentCtrl == "CustomerPortal" && currentAct == "Appointments" ? "active" : "")">
                        <span>📅</span> Lịch hẹn của tôi
                    </a>

                    <a href="/CustomerPortal/History" class="spa-menu-link @(currentCtrl == "CustomerPortal" && currentAct == "History" ? "active" : "")">
                        <span>📸</span> Nhật ký cải thiện da AI
                    </a>

                    <a href="/CustomerPortal/MyPrescriptions" class="spa-menu-link @(currentCtrl == "CustomerPortal" && currentAct == "MyPrescriptions" ? "active" : "")">
                        <span>💊</span> Toa mỹ phẩm tại nhà
                    </a>

                    <a href="/CustomerPortal/Vouchers" class="spa-menu-link @(currentCtrl == "CustomerPortal" && currentAct == "Vouchers" ? "active" : "")">
                        <span>🎟️</span> Ví Voucher & Đổi điểm
                    </a>

                    <a asp-controller="AI" asp-action="Index" class="spa-menu-link @(currentCtrl == "AI" ? "active" : "")">
                        <span>✦</span> Tư vấn Skincare AI
                    </a>
                </nav>
            }
            else
            {
                <div class="spa-menu-title">QUẢN TRỊ TỔNG THỂ</div>

                <nav class="spa-menu">
                    <a asp-controller="Home" asp-action="Index" class="spa-menu-link">
                        <span>🌐</span> Trang chủ công khai
                    </a>

                    <a href="/Admin/Dashboard" class="spa-menu-link @((currentCtrl == "Admin" && currentAct == "Dashboard") || (currentCtrl == "Home" && currentAct == "Dashboard") ? "active" : "")">
                        <span>▦</span> Tổng quan điều hành
                    </a>

                    <div class="spa-menu-title" style="margin-top: 14px;">NGHIỆP VỤ SPA</div>

                    <a asp-controller="Customers" asp-action="Index" class="spa-menu-link @(currentCtrl == "Customers" ? "active" : "")">
                        <span>♙</span> Khách hàng
                    </a>

                    <a asp-controller="Services" asp-action="Index" class="spa-menu-link @(currentCtrl == "Services" ? "active" : "")">
                        <span>✧</span> Dịch vụ
                    </a>

                    <a asp-controller="Appointments" asp-action="Index" class="spa-menu-link @(currentCtrl == "Appointments" ? "active" : "")">
                        <span>▣</span> Lịch hẹn
                    </a>

                    <a asp-controller="Employees" asp-action="Index" class="spa-menu-link @(currentCtrl == "Employees" ? "active" : "")">
                        <span>♧</span> Nhân viên
                    </a>

                    <a asp-controller="Inventory" asp-action="Index" class="spa-menu-link @(currentCtrl == "Inventory" ? "active" : "")">
                        <span>▤</span> Kho mỹ phẩm
                    </a>

                    <a asp-controller="Invoices" asp-action="Index" class="spa-menu-link @(currentCtrl == "Invoices" ? "active" : "")">
                        <span>▧</span> Hóa đơn
                    </a>

                    <a asp-controller="AI" asp-action="Index" class="spa-menu-link @(currentCtrl == "AI" ? "active" : "")">
                        <span>✦</span> Luna AI Studio
                    </a>

                    <a asp-controller="Reports" asp-action="Index" class="spa-menu-link @(currentCtrl == "Reports" ? "active" : "")">
                        <span>▥</span> Báo cáo KPI & P&L
                    </a>
                </nav>
            }

            <div class="sidebar-user-block">
                <div class="spa-user open-user-profile-btn" id="adminSidebarProfile" title="Xem & chỉnh sửa thông tin tài khoản" role="button" tabindex="0">
                    <div class="spa-avatar" id="sidebarAdminAvatar" style="background: @userColor;">@userAvatar</div>
                    <div class="spa-user-text">
                        <strong id="sidebarAdminName">@(userName ?? "Quản trị viên")</strong>
                        <small id="sidebarAdminRole">@(userRoleTitle ?? "Administrator")</small>
                    </div>
                    <span class="spa-user-edit-icon" title="Chỉnh sửa hồ sơ">✏️</span>
                </div>
                <button type="button" class="sidebar-logout-btn open-logout-btn" title="Đăng xuất khỏi hệ thống">
                    ⎋ Đăng xuất
                </button>
            </div>
        </aside>

        <main class="spa-main">
            <header class="spa-topbar">
                <div>
                    <strong id="topbarGreeting">Hệ thống quản lý LUNA SPA & AI Clinic</strong>
                    <p id="topbarSubGreeting">Xin chào @(userName ?? "Quản trị viên")! Chúc bạn một ngày làm việc hiệu quả.</p>
                </div>
                <div class="spa-top-actions">
                    <a asp-controller="Home" asp-action="Index" class="spa-top-public-link" title="Xem giao diện bên ngoài của khách hàng">
                        🌐 Xem trang chủ
                    </a>

                    <a asp-controller="Reports" asp-action="Index" class="spa-top-public-link" style="background: #fdf2f8; color: #a76d8e; border-color: #fbcfe8;" title="Xem báo cáo doanh thu & vận hành">
                        ▥ Báo cáo
                    </a>

                    <button type="button" class="spa-top-profile-btn open-user-profile-btn" id="openAdminProfileTopBtn" title="Xem & chỉnh sửa thông tin hồ sơ">
                        <span class="spa-top-role-badge" id="topbarAdminRoleBadge">@(userRoleTitle ?? "Admin")</span>
                        <span class="spa-top-name" id="topbarAdminName">@(userName ?? "Quản trị viên")</span>
                        <div class="spa-top-avatar" id="topbarAdminAvatar" style="background: @userColor;">@userAvatar</div>
                    </button>

                    <button type="button" class="spa-top-logout-btn open-logout-btn" title="Đăng xuất tài khoản">
                        ⎋ Đăng xuất
                    </button>
                </div>
            </header>

            <section class="spa-content">
                @RenderBody()
            </section>
        </main>

    </div>
}

    <!-- ========================================================================= -->
    <!-- MODAL ĐĂNG NHẬP / ĐĂNG KÝ ĐA VAI TRÒ (KHÁCH HÀNG, NHÂN VIÊN, ADMIN) -->
    <!-- ========================================================================= -->
    <div class="customer-modal-backdrop" id="authModal" style="display:none;">
        <div class="auth-dialog-card">
            <!-- HEADER MODAL -->
            <div class="auth-dialog-header">
                <div class="auth-dialog-header-left">
                    <div class="auth-brand-logo">✿</div>
                    <div>
                        <h2>LUNA SPA & AI CLINIC</h2>
                        <p>Hệ thống định danh & xác thực thành viên</p>
                    </div>
                </div>
                <button type="button" class="customer-modal-close" id="closeAuthModal" title="Đóng cửa sổ">×</button>
            </div>

            <!-- TABS CHUYỂN ĐỔI: ĐĂNG NHẬP vs ĐĂNG KÝ -->
            <div class="auth-tabs">
                <button type="button" class="auth-tab-btn active" id="tabBtnLogin" data-target="loginPanel">
                    🔑 Đăng Nhập
                </button>
                <button type="button" class="auth-tab-btn" id="tabBtnRegister" data-target="registerPanel">
                    ✦ Đăng Ký Mới
                </button>
            </div>

            <div class="auth-panels-body">
                <!-- NỘI DUNG PANEL 1: ĐĂNG NHẬP -->
                <div class="auth-panel active" id="loginPanel">
                    
                    <!-- ⚡ KHỐI ĐĂNG NHẬP NHANH 1-CLICK: ĐẶT NGAY ĐẦU TIÊN CỰC KỲ NỔI BẬT & ĐẦY ĐỦ 4 VAI TRÒ -->
                    <div class="quick-demo-accounts-top">
                        <div class="quick-demo-badge-banner">
                            <span class="badge-icon">⚡</span>
                            <strong>ĐĂNG NHẬP NHANH 1-CLICK (4 VAI TRÒ):</strong>
                        </div>
                        
                        <div class="quick-demo-cards-grid">
                            <!-- 1. QUẢN TRỊ VIÊN -->
                            <button type="button" class="quick-role-card role-card-admin btn-demo-quick" data-role="Admin" title="Đăng nhập tài khoản Quản trị viên tối cao">
                                <span class="role-card-badge-icon" style="background: #fdf2f8; color: #a76d8e; border: 1px solid #fbcfe8;">🛡️</span>
                                <div class="role-card-text">
                                    <strong class="role-title">Quản Trị Viên</strong>
                                    <span class="role-desc">admin@lunaspa.vn</span>
                                </div>
                                <span class="role-card-arrow">➜</span>
                            </button>

                            <!-- 2. BÁC SĨ -->
                            <button type="button" class="quick-role-card role-card-doctor btn-demo-quick" data-role="Doctor" title="Đăng nhập tài khoản BS. CKI Lê Hoàng Yến">
                                <span class="role-card-badge-icon" style="background: #f0f9ff; color: #0284c7; border: 1px solid #bae6fd;">🩺</span>
                                <div class="role-card-text">
                                    <strong class="role-title">Bác Sĩ Da Liễu</strong>
                                    <span class="role-desc">bacsi.yen@lunaspa.vn</span>
                                </div>
                                <span class="role-card-arrow">➜</span>
                            </button>

                            <!-- 3. NHÂN VIÊN (KTV / LỄ TÂN) -->
                            <button type="button" class="quick-role-card role-card-staff btn-demo-quick" data-role="Staff" title="Đăng nhập tài khoản KTV Trưởng Nguyễn Thu Trang">
                                <span class="role-card-badge-icon" style="background: #f0fdfa; color: #0d9488; border: 1px solid #99f6e4;">💆</span>
                                <div class="role-card-text">
                                    <strong class="role-title">Nhân Viên (KTV)</strong>
                                    <span class="role-desc">ktv.trang@lunaspa.vn</span>
                                </div>
                                <span class="role-card-arrow">➜</span>
                            </button>

                            <!-- 4. KHÁCH HÀNG (HỘI VIÊN VIP) -->
                            <button type="button" class="quick-role-card role-card-customer btn-demo-quick" data-role="Customer" title="Đăng nhập tài khoản Khách VIP Nguyễn Thị Minh Anh">
                                <span class="role-card-badge-icon" style="background: #fffbeb; color: #d97706; border: 1px solid #fde68a;">👤</span>
                                <div class="role-card-text">
                                    <strong class="role-title">Khách Hàng (VIP)</strong>
                                    <span class="role-desc">khachhang@gmail.com</span>
                                </div>
                                <span class="role-card-arrow">➜</span>
                            </button>
                        </div>
                    </div>

                    <div class="auth-divider-line">
                        <span>HOẶC ĐĂNG NHẬP BẰNG TÀI KHOẢN</span>
                    </div>

                    <div class="role-selector-wrap">
                        <span class="role-picker-label">Chọn vai trò đăng nhập:</span>
                        <div class="role-pills" id="loginRolePills">
                            <button type="button" class="role-pill active" data-role="Customer">👤 Khách hàng</button>
                            <button type="button" class="role-pill" data-role="Staff">💆 Nhân viên</button>
                            <button type="button" class="role-pill" data-role="Doctor">🩺 Bác sĩ</button>
                            <button type="button" class="role-pill" data-role="Admin">🛡️ Quản trị viên</button>
                        </div>
                    </div>

                    <form id="loginForm" class="auth-form-content">
                        <div class="auth-form-group">
