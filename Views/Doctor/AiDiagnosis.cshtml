@model IEnumerable<GiaoDienSpa.Controllers.DoctorPatientRecord>
@{
    ViewData["Title"] = "Studio Chẩn Đoán & Soi Da AI Lâm Sàng";
}

<div class="customer-page">

    <div class="customer-page-header">
        <div>
            <div class="customer-breadcrumb">
                <a asp-controller="Doctor" asp-action="Dashboard" style="text-decoration:none; color:inherit;">🩺 Bác sĩ</a> / Studio Soi da AI Lâm sàng
            </div>
            <h1>Studio Chẩn Đoán Đa Tầng Biểu Bì & Phác Đồ AI</h1>
            <p>Hệ thống AI Skin Scanner quét quang phổ 5 dải màu, định lượng mật độ sắc tố và phân tích cấu trúc da chuẩn y khoa.</p>
        </div>

        <div style="display: flex; gap: 10px;">
            <a asp-controller="Doctor" asp-action="Dashboard" class="customer-secondary-btn" style="text-decoration:none;">
                ← Về bàn làm việc
            </a>
            <button class="customer-primary-btn" id="btnRunClinicalScan" type="button" style="background: #2b7bb9;">
                <span>✨</span> Chạy quét quang phổ AI mới
            </button>
        </div>
    </div>

    <!-- KHUNG LÀM VIỆC 2 CỘT: ẢNH SOI DA AI & BẢNG CHỈ SỐ LÂM SÀNG -->
    <div style="display: grid; grid-template-columns: minmax(320px, 1fr) minmax(380px, 1.4fr); gap: 20px; margin-top: 10px;">
        
        <!-- CỘT 1: HÌNH ẢNH SOI DA ĐA TẦNG VỚI MAPPING AI -->
        <div class="customer-table-card" style="padding: 20px;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 14px;">
                <h3 style="font-size: 16px; margin: 0; color: #223447;">Bản Đồ Quang Phổ Da Khách Hàng</h3>
                <span class="customer-total-badge" style="background: #e8f3fb; color: #2b7bb9;">AI Map 4K</span>
            </div>

            <div style="position: relative; border-radius: 14px; overflow: hidden; border: 2px solid #e1ecf4; background: #0b1522; min-height: 380px; display: grid; place-items: center;">
                <img src="/images/ai-scan.jpg" alt="AI Skin Mapping" style="width: 100%; height: 100%; object-fit: cover; opacity: 0.9;" id="doctorScanImg" />
                
                <!-- Overlay các điểm phân tích AI -->
                <div style="position: absolute; top: 25%; left: 35%; background: rgba(43, 123, 185, 0.85); color: #fff; padding: 4px 8px; border-radius: 6px; font-size: 11px; font-weight: 700;">
                    ✦ Melanin tầng sâu: 68%
                </div>
                <div style="position: absolute; top: 55%; left: 20%; background: rgba(220, 38, 38, 0.85); color: #fff; padding: 4px 8px; border-radius: 6px; font-size: 11px; font-weight: 700;">
                    ⚠ Nhạy cảm mao mạch: 74%
                </div>
                <div style="position: absolute; top: 65%; right: 25%; background: rgba(39, 140, 87, 0.85); color: #fff; padding: 4px 8px; border-radius: 6px; font-size: 11px; font-weight: 700;">
                    ✓ Độ ẩm đa tầng: 82%
                </div>
            </div>

            <div style="margin-top: 14px; display: flex; gap: 8px;">
                <button type="button" class="btn-status-manage" style="flex:1; justify-content: center;" onclick="switchScanLayer('melanin')">Sắc tố Melanin</button>
                <button type="button" class="btn-status-manage" style="flex:1; justify-content: center;" onclick="switchScanLayer('vascular')">Mao mạch da</button>
                <button type="button" class="btn-status-manage" style="flex:1; justify-content: center;" onclick="switchScanLayer('collagen')">Collagen tầng sâu</button>
            </div>
        </div>

        <!-- CỘT 2: CHỈ SỐ ĐỊNH LƯỢNG & PHÁC ĐỒ CHỈ ĐỊNH CỦA BÁC SĨ -->
        <div class="customer-table-card" style="padding: 24px;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 18px; border-bottom: 1px solid #eef3f7; padding-bottom: 12px;">
                <div>
                    <h3 style="margin: 0; font-size: 17px; color: #1e3a58;">Kết Quả Hội Chẩn Lâm Sàng AI</h3>
                    <span style="font-size: 12px; color: #788a9c;">Bệnh nhân: <strong>Nguyễn Thị Minh Anh</strong> • BN-2026-088</span>
                </div>
                <span class="service-badge-pill" style="background: #2b7bb9; color: #fff;">Độ tin cậy AI: 98.4%</span>
            </div>

            <!-- 5 THANH CHỈ SỐ ĐO LƯỜNG TỪ AI -->
            <div style="display: flex; flex-direction: column; gap: 12px;">
                <div>
                    <div style="display: flex; justify-content: space-between; font-size: 12.5px; font-weight: 700; color: #324458; margin-bottom: 4px;">
                        <span>1. Mật độ Sắc tố Melanin (Đốm nám & tàn nhang)</span>
                        <span style="color: #d97706;">68 / 100 (Báo động trung bình)</span>
                    </div>
                    <div style="height: 8px; background: #eee; border-radius: 4px; overflow: hidden;">
                        <div style="width: 68%; height: 100%; background: linear-gradient(90deg, #f59e0b, #d97706); border-radius: 4px;"></div>
                    </div>
                </div>

                <div>
                    <div style="display: flex; justify-content: space-between; font-size: 12.5px; font-weight: 700; color: #324458; margin-bottom: 4px;">
                        <span>2. Tổn thương do tia cực tím UV & Tạp chất môi trường</span>
                        <span style="color: #dc2626;">74 / 100 (Cần phục hồi biểu bì)</span>
                    </div>
                    <div style="height: 8px; background: #eee; border-radius: 4px; overflow: hidden;">
                        <div style="width: 74%; height: 100%; background: linear-gradient(90deg, #ef4444, #dc2626); border-radius: 4px;"></div>
                    </div>
                </div>

                <div>
                    <div style="display: flex; justify-content: space-between; font-size: 12.5px; font-weight: 700; color: #324458; margin-bottom: 4px;">
                        <span>3. Độ đàn hồi & Mật độ Collagen vi điểm</span>
                        <span style="color: #2563eb;">52 / 100 (Lão hóa độ nhẹ)</span>
                    </div>
                    <div style="height: 8px; background: #eee; border-radius: 4px; overflow: hidden;">
                        <div style="width: 52%; height: 100%; background: linear-gradient(90deg, #3b82f6, #2563eb); border-radius: 4px;"></div>
                    </div>
                </div>

                <div>
                    <div style="display: flex; justify-content: space-between; font-size: 12.5px; font-weight: 700; color: #324458; margin-bottom: 4px;">
                        <span>4. Lỗ chân lông & Tuyến bã nhờn chữ T</span>
                        <span style="color: #16a34a;">32 / 100 (Trong ngưỡng an toàn)</span>
                    </div>
                    <div style="height: 8px; background: #eee; border-radius: 4px; overflow: hidden;">
                        <div style="width: 32%; height: 100%; background: linear-gradient(90deg, #22c55e, #16a34a); border-radius: 4px;"></div>
                    </div>
                </div>
            </div>

            <!-- PHẦN CHỈ ĐỊNH PHÁC ĐỒ CỦA BÁC SĨ -->
            <div style="margin-top: 22px; padding-top: 16px; border-top: 1px dashed #dbe5ee;">
                <h4 style="margin: 0 0 10px; font-size: 14px; color: #1e3a58;">🩺 Chỉ Định Phác Đồ Điều Trị & Toa Dược Mỹ Phẩm:</h4>
                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-bottom: 12px;">
                    <div>
                        <label style="font-size: 11.5px; font-weight: 600; color: #556677;">Thông số Laser Pico (Fluence J/cm2):</label>
                        <input type="text" class="portal-input" value="1.8 J/cm2 - Bước sóng 1064nm" style="font-size: 12.5px;" />
                    </div>
                    <div>
                        <label style="font-size: 11.5px; font-weight: 600; color: #556677;">Số lượt quét (Pass count):</label>
                        <input type="text" class="portal-input" value="2 passes toàn mặt + 1 pass điểm nám" style="font-size: 12.5px;" />
                    </div>
                </div>

                <div>
                    <label style="font-size: 11.5px; font-weight: 600; color: #556677;">Toa sản phẩm dưỡng phục hồi tại nhà:</label>
                    <textarea class="portal-input" rows="2" style="font-size: 12.5px; resize: vertical;">Serum B5 tinh khiết 10% (thoa sáng & tối) + Kem chống nắng phổ rộng SPF 50+ PA++++ không cồn + Xịt khoáng làm dịu lạnh.</textarea>
                </div>

                <div style="display: flex; gap: 10px; margin-top: 14px; justify-content: flex-end;">
                    <button type="button" class="customer-secondary-btn" onclick="alert('Đã in phiếu chẩn đoán da liễu và gửi qua email cho bệnh nhân!')">
                        🖨 In hồ sơ chẩn đoán
                    </button>
                    <button type="button" class="customer-primary-btn" style="background: #2b7bb9;" onclick="window.showLunaToast('✓ Bác sĩ đã duyệt và ký số phác đồ điều trị thành công!', 'success')">
                        💾 Lưu & Ký Duyệt Phác Đồ
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    function switchScanLayer(layer) {
        window.showLunaToast("Đã kích hoạt lớp quét quang phổ: " + layer.toUpperCase(), "success");
    }
</script>
