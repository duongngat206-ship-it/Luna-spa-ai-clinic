    <!-- TOAST THÔNG BÁO TOÀN HỆ THỐNG -->
    <div class="luna-toast" id="lunaGlobalToast">
        <span id="lunaToastIcon">✓</span>
        <span id="lunaToastMessage">Thao tác thành công!</span>
    </div>

    <!-- JAVASCRIPT XÁC THỰC & ĐIỀU KHIỂN TOÀN CỤC -->
    <script>
        // Hàm hiển thị Toast toàn hệ thống
        window.showLunaToast = function (message, type = 'success') {
            const toast = document.getElementById("lunaGlobalToast");
            const msgEl = document.getElementById("lunaToastMessage");
            const iconEl = document.getElementById("lunaToastIcon");
            if (!toast) return;

            msgEl.textContent = message;
            if (type === 'error') {
                toast.style.background = '#821a1a';
                iconEl.textContent = '✕';
            } else {
                toast.style.background = '#30243d';
                iconEl.textContent = '✓';
            }

            toast.classList.add("show");
            setTimeout(() => {
                toast.classList.remove("show");
            }, 3500);
        };

        document.addEventListener("DOMContentLoaded", function () {
            // ==========================================
            // QUẢN LÝ MODAL AUTH (LOGIN / REGISTER)
            // ==========================================
            const authModal = document.getElementById("authModal");
            const closeAuthBtn = document.getElementById("closeAuthModal");
            const tabBtnLogin = document.getElementById("tabBtnLogin");
            const tabBtnRegister = document.getElementById("tabBtnRegister");
            const loginPanel = document.getElementById("loginPanel");
            const registerPanel = document.getElementById("registerPanel");

            let currentLoginRole = "Customer";
            let currentRegisterRole = "Customer";

            // Mở modal Auth
            document.querySelectorAll(".open-auth-modal-btn").forEach(btn => {
                btn.addEventListener("click", function () {
                    const mode = this.getAttribute("data-mode") || "login";
                    const role = this.getAttribute("data-role") || "Customer";

                    if (mode === "register") {
                        switchTab("register");
                        setRegisterRole(role);
                    } else {
                        switchTab("login");
                        setLoginRole(role);
                    }

                    authModal.style.display = "flex";
                });
            });

            function closeAuth() {
                authModal.style.display = "none";
            }

            if (closeAuthBtn) closeAuthBtn.addEventListener("click", closeAuth);
            authModal.addEventListener("click", function (e) {
                if (e.target === authModal) closeAuth();
            });

            // Chuyển tab Đăng nhập / Đăng ký
            function switchTab(tab) {
                if (tab === "register") {
                    tabBtnRegister.classList.add("active");
                    tabBtnLogin.classList.remove("active");
                    registerPanel.classList.add("active");
                    loginPanel.classList.remove("active");
                } else {
                    tabBtnLogin.classList.add("active");
                    tabBtnRegister.classList.remove("active");
                    loginPanel.classList.add("active");
                    registerPanel.classList.remove("active");
                }
            }

            tabBtnLogin?.addEventListener("click", () => switchTab("login"));
            tabBtnRegister?.addEventListener("click", () => switchTab("register"));

            // Chọn vai trò Đăng nhập
            const loginPills = document.querySelectorAll("#loginRolePills .role-pill");
            function setLoginRole(role) {
                currentLoginRole = role;
                loginPills.forEach(p => {
                    if (p.getAttribute("data-role") === role) p.classList.add("active");
                    else p.classList.remove("active");
                });

                const emailInput = document.getElementById("loginEmail");
                const passInput = document.getElementById("loginPassword");
                if (role === "Admin") {
                    emailInput.placeholder = "Ví dụ: admin@lunaspa.vn";
                    emailInput.value = "admin@lunaspa.vn";
                } else if (role === "Doctor") {
                    emailInput.placeholder = "Ví dụ: bacsi.yen@lunaspa.vn";
                    emailInput.value = "bacsi.yen@lunaspa.vn";
                } else if (role === "Staff") {
                    emailInput.placeholder = "Ví dụ: ktv.trang@lunaspa.vn";
                    emailInput.value = "ktv.trang@lunaspa.vn";
                } else {
                    emailInput.placeholder = "Ví dụ: khachhang@gmail.com";
                    emailInput.value = "khachhang@gmail.com";
                }
                if (passInput) passInput.value = "123456";
            }

            loginPills.forEach(pill => {
                pill.addEventListener("click", function () {
                    setLoginRole(this.getAttribute("data-role"));
                });
            });

            // Chọn vai trò Đăng ký
            const regPills = document.querySelectorAll("#registerRolePills .role-pill");
            const groupSpecialty = document.getElementById("groupRegSpecialty");
            const groupAdminCode = document.getElementById("groupRegAdminCode");
            const groupConcern = document.getElementById("groupRegConcern");

            function setRegisterRole(role) {
                currentRegisterRole = role;
                regPills.forEach(p => {
                    if (p.getAttribute("data-role") === role) p.classList.add("active");
                    else p.classList.remove("active");
                });

                if (role === "Admin") {
                    groupAdminCode.style.display = "block";
                    groupSpecialty.style.display = "none";
                    groupConcern.style.display = "none";
                } else if (role === "Doctor" || role === "Staff") {
                    groupSpecialty.style.display = "block";
                    groupAdminCode.style.display = "none";
                    groupConcern.style.display = "none";
                } else {
                    groupConcern.style.display = "block";
                    groupSpecialty.style.display = "none";
                    groupAdminCode.style.display = "none";
                }
            }

            regPills.forEach(pill => {
                pill.addEventListener("click", function () {
                    setRegisterRole(this.getAttribute("data-role"));
                });
            });

            // ==========================================
            // SUBMIT ĐĂNG NHẬP
            // ==========================================
            document.getElementById("loginForm")?.addEventListener("submit", async function (e) {
                e.preventDefault();
                const email = document.getElementById("loginEmail").value.trim();
                const password = document.getElementById("loginPassword").value;
                const rememberMe = document.getElementById("loginRememberMe").checked;
                const btn = document.getElementById("btnSubmitLogin");

                btn.innerHTML = `<span>⏳</span> Đang xác thực...`;
                btn.disabled = true;

                try {
                    const resp = await fetch("/Account/Login", {
                        method: "POST",
                        headers: { "Content-Type": "application/json" },
                        body: JSON.stringify({
                            Email: email,
                            Password: password,
                            Role: currentLoginRole,
                            RememberMe: rememberMe
                        })
                    });

                    const data = await resp.json();
                    if (data.success) {
                        window.showLunaToast(data.message, "success");
                        closeAuth();
                        setTimeout(() => {
                            window.location.href = data.redirectUrl || "/";
                        }, 700);
                    } else {
                        alert(data.message || "Đăng nhập thất bại. Vui lòng kiểm tra lại thông tin!");
                    }
                } catch (err) {
                    console.error("Login error:", err);
                    alert("Lỗi kết nối máy chủ. Vui lòng thử lại!");
                } finally {
                    btn.innerHTML = `<span>✓</span> Đăng Nhập Hệ Thống`;
                    btn.disabled = false;
                }
            });

            // ==========================================
            // SUBMIT ĐĂNG KÝ
            // ==========================================
            document.getElementById("registerForm")?.addEventListener("submit", async function (e) {
                e.preventDefault();
                const fullName = document.getElementById("regFullName").value.trim();
                const phone = document.getElementById("regPhone").value.trim();
                const email = document.getElementById("regEmail").value.trim();
                const password = document.getElementById("regPassword").value;
                const confirmPass = document.getElementById("regConfirmPassword").value;
                const specialty = document.getElementById("regSpecialty")?.value || "";
                const adminCode = document.getElementById("regAdminCode")?.value.trim() || "";
                const concern = document.getElementById("regSkinConcern")?.value || "";
                const btn = document.getElementById("btnSubmitRegister");

                if (password !== confirmPass) {
                    alert("Mật khẩu xác nhận không khớp!");
                    return;
                }

                btn.innerHTML = `<span>⏳</span> Đang tạo tài khoản...`;
                btn.disabled = true;

                try {
                    const resp = await fetch("/Account/Register", {
                        method: "POST",
                        headers: { "Content-Type": "application/json" },
                        body: JSON.stringify({
                            FullName: fullName,
                            Phone: phone,
                            Email: email,
                            Password: password,
                            ConfirmPassword: confirmPass,
                            Role: currentRegisterRole,
                            Specialty: specialty,
                            AdminAccessCode: adminCode,
                            SkinConcern: concern
                        })
                    });

                    const data = await resp.json();
                    if (data.success) {
                        window.showLunaToast(data.message, "success");
                        closeAuth();
                        setTimeout(() => {
                            window.location.href = data.redirectUrl || "/";
                        }, 800);
                    } else {
                        alert(data.message || "Đăng ký không thành công!");
                    }
                } catch (err) {
                    console.error("Register error:", err);
                    alert("Lỗi kết nối máy chủ. Vui lòng thử lại!");
                } finally {
                    btn.innerHTML = `<span>✦</span> Đăng Ký Tài Khoản Ngay`;
                    btn.disabled = false;
                }
            });

            // ==========================================
            // ĐĂNG NHẬP NHANH 1-CLICK DEMO (4 VAI TRÒ)
            // ==========================================
            document.querySelectorAll(".btn-demo-quick").forEach(btn => {
                btn.addEventListener("click", async function (e) {
                    e.preventDefault();
                    e.stopPropagation();
                    const role = this.getAttribute("data-role") || "Customer";
                    const prevHtml = this.innerHTML;
                    this.innerHTML = `<span>⏳</span> Đang nạp...`;

                    try {
                        const resp = await fetch("/Account/QuickLogin", {
                            method: "POST",
                            headers: { "Content-Type": "application/json" },
                            body: JSON.stringify({ Role: role })
                        });
                        const data = await resp.json();
                        if (data && data.success) {
                            window.showLunaToast(data.message, "success");
                            closeAuth();
                            setTimeout(() => {
                                window.location.href = data.redirectUrl || "/";
                            }, 400);
                        } else {
                            window.location.href = "/Account/QuickLoginDirect?role=" + encodeURIComponent(role);
                        }
                    } catch (err) {
                        console.error("Quick login error:", err);
                        window.location.href = "/Account/QuickLoginDirect?role=" + encodeURIComponent(role);
                    }
                });
            });

            // ==========================================
            // XỬ LÝ ĐĂNG XUẤT (LOGOUT)
            // ==========================================
            const logoutModal = document.getElementById("logoutConfirmModal");
            const closeLogoutBtn = document.getElementById("closeLogoutConfirmModal");
            const cancelLogoutBtn = document.getElementById("btnCancelLogout");
            const confirmLogoutBtn = document.getElementById("btnConfirmLogout");

            document.querySelectorAll(".open-logout-btn").forEach(btn => {
                btn.addEventListener("click", function () {
                    logoutModal.style.display = "grid";
                });
            });

            function closeLogout() {
                logoutModal.style.display = "none";
            }

            if (closeLogoutBtn) closeLogoutBtn.addEventListener("click", closeLogout);
            if (cancelLogoutBtn) cancelLogoutBtn.addEventListener("click", closeLogout);
            logoutModal.addEventListener("click", function (e) {
                if (e.target === logoutModal) closeLogout();
            });

            if (confirmLogoutBtn) {
                confirmLogoutBtn.addEventListener("click", async function () {
                    this.innerHTML = "<span>⏳</span> Đang đăng xuất...";
                    try {
                        const resp = await fetch("/Account/Logout", {
                            method: "POST",
                            headers: { "Content-Type": "application/json", "X-Requested-With": "XMLHttpRequest" }
                        });
                        const data = await resp.json();
                        window.showLunaToast("✓ Đã đăng xuất thành công khỏi hệ thống!", "success");
                        setTimeout(() => {
                            window.location.href = "/";
                        }, 500);
                    } catch (err) {
                        window.location.href = "/Account/Logout";
                    }
                });
            }

            // Trợ giúp quên mật khẩu
            document.getElementById("btnForgotPassHelp")?.addEventListener("click", function () {
                alert("✦ HƯỚNG DẪN TRUY CẬP 4 VAI TRÒ HỆ THỐNG:\n\n1. Quản trị viên (Admin): admin@lunaspa.vn\n2. Bác sĩ Da liễu: bacsi.yen@lunaspa.vn\n3. Nhân viên (KTV): ktv.trang@lunaspa.vn\n4. Khách hàng (VIP): khachhang@gmail.com\n\n• Mật khẩu demo chung: 123456\n• Hoặc bạn chỉ cần bấm vào nút 'Đăng nhập nhanh 1-Click' ở khung trên để vào thẳng hệ thống!");
            });

            // ==========================================
            // BẬT / TẮT MẮT XEM MẬT KHẨU (PASSWORD EYE TOGGLE)
            // ==========================================
            document.addEventListener("click", function (e) {
                const btn = e.target.closest(".btn-toggle-password");
                if (!btn) return;
                e.preventDefault();
                const targetId = btn.getAttribute("data-target");
                const input = document.getElementById(targetId);
                if (!input) return;

                const icon = btn.querySelector(".eye-icon") || btn;
                if (input.type === "password") {
                    input.type = "text";
                    icon.textContent = "🙈";
                    btn.setAttribute("title", "Ẩn mật khẩu");
                } else {
                    input.type = "password";
                    icon.textContent = "👁️";
                    btn.setAttribute("title", "Hiển thị mật khẩu");
                }
            });

            // ==========================================
            // QUẢN LÝ CHỈNH SỬA HỒ SƠ CÁ NHÂN (ADMIN, NHÂN VIÊN, KHÁCH HÀNG)
            // ==========================================
            const profileModal = document.getElementById("userProfileModal");
            const closeProfileBtn = document.getElementById("closeUserProfileModal");
            const cancelProfileBtn = document.getElementById("btnCancelProfile");
            const profileForm = document.getElementById("userProfileForm");

            function closeUserProfile() {
                if (profileModal) profileModal.style.display = "none";
            }

            if (closeProfileBtn) closeProfileBtn.addEventListener("click", closeUserProfile);
            if (cancelProfileBtn) cancelProfileBtn.addEventListener("click", closeUserProfile);
            if (profileModal) {
                profileModal.addEventListener("click", function (e) {
                    if (e.target === profileModal) closeUserProfile();
                });
            }

            // Chọn màu đại diện Avatar
            document.querySelectorAll(".prof-color-dot").forEach(dot => {
                dot.addEventListener("click", function () {
                    document.querySelectorAll(".prof-color-dot").forEach(d => d.classList.remove("active"));
                    this.classList.add("active");
                    const color = this.getAttribute("data-color");
                    document.getElementById("profSelectedColor").value = color;
                    const preview = document.getElementById("profAvatarPreview");
                    if (preview) preview.style.background = color;
                });
            });

            // Mở modal hồ sơ
            document.querySelectorAll(".open-user-profile-btn").forEach(btn => {
                btn.addEventListener("click", async function (e) {
                    e.preventDefault();
                    try {
                        const resp = await fetch("/Account/GetProfile");
                        const data = await resp.json();
                        if (data.success && data.user) {
                            const u = data.user;
                            document.getElementById("profHeaderName").textContent = u.fullName;
                            document.getElementById("profHeaderEmail").textContent = u.email;
                            document.getElementById("profRoleBadgePill").textContent = "✦ " + u.roleTitle;
                            document.getElementById("profAvatarPreview").textContent = u.avatarInitials;
                            document.getElementById("profAvatarPreview").style.background = u.avatarColor || "#a76d8e";
                            document.getElementById("profSelectedColor").value = u.avatarColor || "#a76d8e";

                            // Kích hoạt dot màu tương ứng
                            document.querySelectorAll(".prof-color-dot").forEach(d => {
                                if (d.getAttribute("data-color").toLowerCase() === (u.avatarColor || "").toLowerCase()) {
                                    d.classList.add("active");
                                } else {
                                    d.classList.remove("active");
                                }
                            });

                            document.getElementById("profFullName").value = u.fullName || "";
                            document.getElementById("profPhone").value = u.phone || "";
                            document.getElementById("profEmail").value = u.email || "";
                            document.getElementById("profRoleTitle").value = u.roleTitle || "";

                            const grpSpecialty = document.getElementById("groupProfSpecialty");
                            const grpSkinConcern = document.getElementById("groupProfSkinConcern");
                            const inputSpecialty = document.getElementById("profSpecialty");
                            const selectSkinConcern = document.getElementById("profSkinConcern");

                            if (u.role === "Admin" || u.role === "Staff") {
                                if (grpSpecialty) grpSpecialty.style.display = "block";
                                if (grpSkinConcern) grpSkinConcern.style.display = "none";
                                if (inputSpecialty) inputSpecialty.value = u.specialty || "";
                            } else {
                                if (grpSpecialty) grpSpecialty.style.display = "none";
                                if (grpSkinConcern) grpSkinConcern.style.display = "block";
                                if (selectSkinConcern && u.skinConcern) {
                                    selectSkinConcern.value = u.skinConcern;
                                }
                            }

                            // Xóa trắng ô mật khẩu
                            document.getElementById("profCurrentPassword").value = "";
                            document.getElementById("profNewPassword").value = "";
                            document.getElementById("profConfirmNewPassword").value = "";

                            profileModal.style.display = "flex";
                        } else {
                            window.showLunaToast("Vui lòng đăng nhập để xem và sửa hồ sơ cá nhân!", "warning");
                            document.getElementById("authModal").style.display = "flex";
                        }
                    } catch (err) {
                        console.error("Lỗi lấy thông tin hồ sơ:", err);
                    }
                });
            });

            // Submit cập nhật hồ sơ
            if (profileForm) {
                profileForm.addEventListener("submit", async function (e) {
                    e.preventDefault();
                    const submitBtn = document.getElementById("btnSaveUserProfile");
                    submitBtn.disabled = true;
                    submitBtn.innerHTML = "<span>⏳</span> Đang lưu...";

                    const payload = {
                        FullName: document.getElementById("profFullName").value.trim(),
                        Phone: document.getElementById("profPhone").value.trim(),
                        RoleTitle: document.getElementById("profRoleTitle")?.value.trim(),
                        Specialty: document.getElementById("profSpecialty")?.value.trim(),
                        SkinConcern: document.getElementById("profSkinConcern")?.value,
                        AvatarColor: document.getElementById("profSelectedColor").value,
                        CurrentPassword: document.getElementById("profCurrentPassword").value,
                        NewPassword: document.getElementById("profNewPassword").value,
                        ConfirmNewPassword: document.getElementById("profConfirmNewPassword").value
                    };

                    try {
                        const resp = await fetch("/Account/UpdateProfile", {
                            method: "POST",
                            headers: { "Content-Type": "application/json" },
                            body: JSON.stringify(payload)
                        });
                        const data = await resp.json();

                        if (data.success) {
                            window.showLunaToast("✓ Cập nhật hồ sơ cá nhân thành công!", "success");
                            closeUserProfile();

                            // Cập nhật ngay các avatar, tên hiển thị trên giao diện
                            const u = data.user;
                            const portalName = document.getElementById("portalUserName");
                            if (portalName) portalName.innerHTML = u.fullName + ' <span style="font-size: 11px; opacity: 0.7;">✏️</span>';
                            const portalAvatar = document.getElementById("portalUserAvatar");
                            if (portalAvatar) {
                                portalAvatar.textContent = u.avatarInitials;
                                portalAvatar.style.background = u.avatarColor;
                            }
                            const portalRole = document.getElementById("portalUserRole");
                            if (portalRole) portalRole.textContent = u.roleTitle;

                            const sideName = document.getElementById("sidebarAdminName");
                            if (sideName) sideName.textContent = u.fullName;
                            const sideRole = document.getElementById("sidebarAdminRole");
                            if (sideRole) sideRole.textContent = u.roleTitle;
                            const sideAvatar = document.getElementById("sidebarAdminAvatar");
                            if (sideAvatar) {
                                sideAvatar.textContent = u.avatarInitials;
                                sideAvatar.style.background = u.avatarColor;
                            }

                            const topName = document.getElementById("topbarAdminName");
                            if (topName) topName.textContent = u.fullName;
                            const topRole = document.getElementById("topbarAdminRoleBadge");
                            if (topRole) topRole.textContent = u.roleTitle;
                            const topAvatar = document.getElementById("topbarAdminAvatar");
                            if (topAvatar) {
                                topAvatar.textContent = u.avatarInitials;
                                topAvatar.style.background = u.avatarColor;
                            }
                        } else {
                            window.showLunaToast(data.message || "Không thể cập nhật hồ sơ. Vui lòng kiểm tra lại!", "error");
                        }
                    } catch (err) {
                        console.error("Lỗi cập nhật hồ sơ:", err);
                        window.showLunaToast("Đã xảy ra lỗi khi lưu hồ sơ!", "error");
                    } finally {
                        submitBtn.disabled = false;
                        submitBtn.innerHTML = "<span>💾</span> Lưu Thay Đổi Hồ Sơ";
                    }
                });
            }
        });
    </script>

