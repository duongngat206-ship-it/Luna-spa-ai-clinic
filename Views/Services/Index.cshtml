@model IEnumerable<GiaoDienSpa.Models.SpaService>

@{
    ViewData["Title"] = "Quản lý dịch vụ";
}

<div class="customer-page service-page">

    <!-- TIÊU ĐỀ TRANG -->
    <div class="customer-page-header">
        <div>
            <div class="customer-breadcrumb">LUNA SPA / Menu dịch vụ</div>
            <h1>Danh mục dịch vụ & Phác đồ trị liệu</h1>
            <p>Menu chăm sóc sắc đẹp, công nghệ trẻ hóa da hiện đại và tối ưu combo dịch vụ bằng AI.</p>
        </div>

        <div style="display: flex; gap: 10px; flex-wrap: wrap;">
            <button class="spa-ai-btn" id="openAiComboModal" type="button">
                <span>✨</span> AI Thiết kế Combo liệu trình
            </button>
            <button class="customer-primary-btn" id="openServiceModal" type="button">
                <span>＋</span> Thêm dịch vụ mới
            </button>
        </div>
    </div>

    <!-- 4 THẺ THỐNG KÊ DỊCH VỤ -->
    <div class="customer-stats">
        <div class="customer-stat-card">
            <div class="customer-stat-icon stat-purple">✧</div>
            <div>
                <span class="customer-stat-label">Tổng số dịch vụ</span>
                <strong id="totalServices">@ViewBag.TotalServices</strong>
                <small>Phác đồ tiêu chuẩn quốc tế</small>
            </div>
        </div>

        <div class="customer-stat-card">
            <div class="customer-stat-icon stat-green">✦</div>
            <div>
                <span class="customer-stat-label">Trẻ hóa công nghệ cao</span>
                <strong id="highTechServices">@ViewBag.HighTechServices</strong>
                <small>Laser Pico, Hifu, Diode Laser</small>
            </div>
        </div>

        <div class="customer-stat-card">
            <div class="customer-stat-icon stat-orange">♧</div>
            <div>
                <span class="customer-stat-label">Massage & Trị liệu</span>
                <strong id="massageServices">@ViewBag.BodyMassageServices</strong>
                <small>Đá nóng, Thảo dược, Gội đầu</small>
            </div>
        </div>

        <div class="customer-stat-card">
            <div class="customer-stat-icon stat-blue">✿</div>
            <div>
                <span class="customer-stat-label">Chăm sóc da chuyên sâu</span>
                <strong id="skincareServices">@ViewBag.SkincareServices</strong>
                <small>Aqua Detox, Peel sinh học, Mụn</small>
            </div>
        </div>
    </div>

    <!-- AI SMART BANNER -->
    <div class="spa-ai-banner">
        <div class="spa-ai-banner-left">
            <div class="spa-ai-icon-pulse">✦</div>
            <div class="spa-ai-content">
                <span class="spa-ai-tag">✨ TRỢ LÝ THIẾT KẾ MENU & TỐI ƯU COMBO AI</span>
                <p class="spa-ai-text">
                    Phân tích giỏ hàng cho thấy khách hàng làm dịch vụ <strong>Laser Pico Pro</strong> có tỷ lệ tái đặt lịch cao hơn 45% khi được kết hợp <strong>Điện di Tế bào gốc</strong> và <strong>Mặt nạ vàng 24K</strong>. Đề xuất gói Combo Glow Up 2026 với ưu đãi 22%.
                </p>
            </div>
        </div>
        <button class="spa-ai-btn" id="aiComboBannerBtn" type="button">Xem chi tiết Combo AI</button>
    </div>

    <!-- THANH CÔNG CỤ TÌM KIẾM & BỘ LỌC -->
    <div class="customer-content-card" style="padding: 18px 22px; margin-bottom: 22px;">
        <div class="customer-toolbar" style="padding: 0;">
            <div class="customer-search-box">
                <span>⌕</span>
                <input type="text" id="serviceSearch"
                       placeholder="Tìm kiếm theo tên dịch vụ, mã DV, công nghệ..." />
            </div>

            <select id="serviceCategoryFilter" class="customer-filter">
                <option value="">Tất cả danh mục</option>
                <option value="Trẻ hóa công nghệ cao">Trẻ hóa công nghệ cao</option>
                <option value="Chăm sóc da chuyên sâu">Chăm sóc da chuyên sâu</option>
                <option value="Massage & Trị liệu">Massage & Trị liệu</option>
                <option value="Chăm sóc body">Chăm sóc body</option>
            </select>

            <button class="customer-secondary-btn" id="resetServiceFilter" type="button">
                ↺ Làm mới
            </button>
        </div>
    </div>

    <!-- LƯỚI THẺ DỊCH VỤ CAO CẤP -->
    <div class="service-grid" id="serviceGrid">
        <!-- Javascript renders dynamically -->
    </div>

    <div id="serviceNoResult" class="service-no-result" style="display:none;">
        Không tìm thấy dịch vụ phù hợp với bộ lọc tìm kiếm.
    </div>

</div>

<!-- MODAL THÊM / SỬA DỊCH VỤ -->
<div class="customer-modal-backdrop" id="serviceModal">
    <div class="customer-modal">
        <div class="customer-modal-header">
            <div>
                <h2 id="serviceModalTitle">Thêm dịch vụ làm đẹp mới</h2>
                <p>Khai báo phác đồ điều trị, thời lượng và bảng giá niêm yết.</p>
            </div>
            <button type="button" class="customer-modal-close" id="closeServiceModal">×</button>
        </div>

        <form id="serviceForm">
            <input type="hidden" id="serviceEditId" />

            <div class="customer-form-grid">
                <div class="customer-form-group">
                    <label for="srvName">Tên dịch vụ <span>*</span></label>
                    <input id="srvName" type="text" placeholder="Ví dụ: Nâng cơ Hifu Ultra Collagen..." required />
                </div>

                <div class="customer-form-group">
                    <label for="srvCategory">Danh mục dịch vụ <span>*</span></label>
                    <select id="srvCategory" required>
                        <option value="Trẻ hóa công nghệ cao">Trẻ hóa công nghệ cao</option>
                        <option value="Chăm sóc da chuyên sâu">Chăm sóc da chuyên sâu</option>
                        <option value="Massage & Trị liệu">Massage & Trị liệu</option>
                        <option value="Chăm sóc body">Chăm sóc body</option>
                    </select>
                </div>

                <div class="customer-form-group">
                    <label for="srvPrice">Giá niêm yết (VNĐ) <span>*</span></label>
                    <input id="srvPrice" type="number" min="50000" step="10000" value="500000" required />
                </div>

                <div class="customer-form-group">
                    <label for="srvDuration">Thời lượng liệu trình (Phút) <span>*</span></label>
                    <input id="srvDuration" type="number" min="15" max="300" step="15" value="60" required />
                </div>

                <div class="customer-form-group">
                    <label for="srvIcon">Biểu tượng Icon</label>
                    <select id="srvIcon">
                        <option value="✦">✦ Ngôi sao lấp lánh (Laser/High-Tech)</option>
                        <option value="✧">✧ Kim cương nâng cơ</option>
                        <option value="✿">✿ Hoa đào (Chăm sóc da)</option>
                        <option value="♧">♧ Thảo mộc (Massage)</option>
                        <option value="❀">❀ Hoa cúc dịu da</option>
                        <option value="◇">◇ Đá bazan nhiệt</option>
                    </select>
                </div>

                <div class="customer-form-group">
                    <label for="srvCosmetics">Mỹ phẩm khuyên dùng kèm</label>
                    <input id="srvCosmetics" type="text" placeholder="Ví dụ: Serum B5 HA & Kem chống nắng..." />
                </div>

                <div class="customer-form-group customer-form-full">
                    <label for="srvDescription">Mô tả quy trình liệu trình <span>*</span></label>
                    <textarea id="srvDescription" rows="3" placeholder="Mô tả các bước thực hiện và hiệu quả mang lại cho khách hàng..." required></textarea>
                </div>
            </div>

            <div class="customer-modal-footer">
                <button type="button" class="customer-secondary-btn" id="cancelServiceModal">Hủy</button>
                <button type="submit" class="customer-primary-btn" id="saveServiceBtn">Lưu dịch vụ</button>
            </div>
        </form>
    </div>
</div>

<!-- MODAL AI THIẾT KẾ COMBO LIỆU TRÌNH -->
<div class="customer-modal-backdrop" id="aiComboModal">
    <div class="customer-modal" style="max-width: 640px;">
        <div class="customer-modal-header" style="background: linear-gradient(135deg, #fdf8fb 0%, #faedf4 100%);">
            <div>
                <span class="spa-ai-tag">✨ TRỢ LÝ THIẾT KẾ COMBO LUNA AI</span>
                <h2 style="color: #985c7e; margin-top: 4px;">Gói Combo Trẻ Hóa Toàn Diện 2026</h2>
                <p>Tối ưu tỷ lệ chuyển đổi dịch vụ và nâng cao mức độ hài lòng của khách hàng.</p>
            </div>
            <button type="button" class="customer-modal-close" id="closeAiComboModal">×</button>
        </div>

        <div style="padding: 22px 25px;">
            <div style="background: #fdfafd; border: 1px solid #eee7ed; border-radius: 12px; padding: 16px; margin-bottom: 16px;">
                <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:10px;">
                    <strong style="color: #3b2c4e; font-size: 15px;">Combo Nâng Tầm Nhan Sắc - Glow Up 2026</strong>
                    <span style="background: #e8f7ef; color: #278c57; font-weight: 700; font-size: 12px; padding: 4px 10px; border-radius: 20px;">
                        Tiết kiệm 22%
                    </span>
                </div>

                <ul style="margin: 0; padding-left: 20px; font-size: 13px; color: #554867; line-height: 1.8;">
                    <li><strong>Dịch vụ chính:</strong> Trẻ hóa da Laser Pico Pro (Trị giá 2.500.000 đ)</li>
                    <li><strong>Phục hồi chuyên sâu:</strong> Điện di Tế bào gốc Tái sinh (Trị giá 1.250.000 đ)</li>
                    <li><strong>Quà tặng đính kèm:</strong> Hộp Mặt Nạ Vàng 24K Collagen (Trị giá 980.000 đ)</li>
                </ul>

                <div style="margin-top: 14px; padding-top: 12px; border-top: 1px dashed #e5d7eb; display:flex; justify-content:space-between; align-items:center;">
                    <div>
                        <span style="font-size: 12px; color: #958a9f; text-decoration: line-through;">Giá gốc: 4.730.000 đ</span>
                        <div style="font-size: 20px; font-weight: 800; color: #985c7e;">Giá Combo: 3.690.000 đ</div>
                    </div>
                    <span class="spa-ai-tag">AI ĐỀ XUẤT</span>
                </div>
            </div>

            <div style="background: #fbf5f8; border: 1px solid #ebd8e5; border-radius: 10px; padding: 12px 14px; font-size: 12px; color: #79576e;">
                💡 <strong>Dự báo AI:</strong> Áp dụng gói Combo này giúp tăng giá trị đơn hàng trung bình thêm <strong>1.190.000 đ/khách</strong> và tăng tỷ lệ khách quay lại đạt 82%.
            </div>
        </div>

        <div class="customer-modal-footer">
            <button type="button" class="customer-secondary-btn" id="closeAiComboBtn">Đóng</button>
            <button type="button" class="customer-primary-btn" id="publishComboBtn">
                ✓ Áp dụng Combo vào Menu Spa
            </button>
        </div>
    </div>
</div>

@section Scripts {
<script>
    let services = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model, new System.Text.Json.JsonSerializerOptions { PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase }));

    const grid = document.getElementById("serviceGrid");
    const noResult = document.getElementById("serviceNoResult");
    const modal = document.getElementById("serviceModal");
    const form = document.getElementById("serviceForm");
    const aiComboModal = document.getElementById("aiComboModal");

    function escapeHtml(val) {
        return String(val ?? "").replace(/[&<>"']/g, function (c) {
            return { "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#039;" }[c];
        });
    }

    function formatCurrency(num) {
        return Number(num || 0).toLocaleString("vi-VN") + " đ";
    }

    function renderServices() {
        const keyword = document.getElementById("serviceSearch").value.trim().toLowerCase();
        const category = document.getElementById("serviceCategoryFilter").value;

        const filtered = services.filter(s => {
            const matchKeyword =
                s.serviceName.toLowerCase().includes(keyword) ||
                (s.serviceCode && s.serviceCode.toLowerCase().includes(keyword)) ||
                (s.description && s.description.toLowerCase().includes(keyword));

            const matchCategory = !category || s.category === category;
            return matchKeyword && matchCategory;
        });

        grid.innerHTML = "";

        if (filtered.length === 0) {
            noResult.style.display = "block";
        } else {
            noResult.style.display = "none";
            filtered.forEach(s => {
                const article = document.createElement("article");
                article.className = "service-card";
                article.innerHTML = `
                    <div class="service-card-top">
                        <div class="service-icon">${escapeHtml(s.icon || '✧')}</div>
                        <span class="service-status">${escapeHtml(s.status || 'Đang cung cấp')}</span>
                    </div>

                    <span class="service-category">${escapeHtml(s.category)}</span>
                    <h3>${escapeHtml(s.serviceName)}</h3>
                    <p class="service-description">${escapeHtml(s.description)}</p>

                    ${s.recommendedCosmetics ? `
                        <div style="font-size:11px; color:#85647a; background:#fdf7fa; padding:6px 9px; border-radius:6px; margin-bottom:12px; border:1px dashed #f0dfe9;">
                            🧴 <strong>Dưỡng kèm:</strong> ${escapeHtml(s.recommendedCosmetics)}
                        </div>
                    ` : ''}

                    <div class="service-details">
                        <div>
                            <span>Thời lượng</span>
                            <strong>◷ ${s.durationMinutes} phút</strong>
                        </div>
                        <div>
                            <span>Giá dịch vụ</span>
                            <strong class="service-price">${formatCurrency(s.price)}</strong>
                        </div>
                    </div>

                    <div style="display:flex; gap:8px; margin-top:14px;">
                        <a href="/Appointments?service=${encodeURIComponent(s.serviceName)}" class="service-book-button" style="flex:1;">
                            Đặt lịch ngay <span>→</span>
                        </a>
                        <button type="button" class="appointment-action-btn" title="Chỉnh sửa dịch vụ" data-action="edit" data-id="${s.serviceId}" style="width:38px; opacity:1; cursor:pointer;">
                            ✎
                        </button>
                        <button type="button" class="appointment-action-btn" title="Xóa dịch vụ" data-action="delete" data-id="${s.serviceId}" style="width:38px; opacity:1; cursor:pointer; color:#d65e69;">
                            ⌫
                        </button>
                    </div>
                `;
                grid.appendChild(article);
            });
        }

        document.getElementById("totalServices").textContent = services.length;
        document.getElementById("highTechServices").textContent = services.filter(s => s.category === "Trẻ hóa công nghệ cao").length;
        document.getElementById("massageServices").textContent = services.filter(s => s.category === "Massage & Trị liệu").length;
        document.getElementById("skincareServices").textContent = services.filter(s => s.category === "Chăm sóc da chuyên sâu").length;
    }

    function openModal(s = null) {
        form.reset();
        document.getElementById("serviceEditId").value = "";
        document.getElementById("serviceModalTitle").textContent = s ? "Chỉnh sửa dịch vụ" : "Thêm dịch vụ mới";

        if (s) {
            document.getElementById("serviceEditId").value = s.serviceId;
            document.getElementById("srvName").value = s.serviceName;
            document.getElementById("srvCategory").value = s.category;
            document.getElementById("srvPrice").value = s.price;
            document.getElementById("srvDuration").value = s.durationMinutes;
            document.getElementById("srvIcon").value = s.icon || "✧";
            document.getElementById("srvCosmetics").value = s.recommendedCosmetics || "";
            document.getElementById("srvDescription").value = s.description;
        }

        modal.classList.add("show");
    }

    function closeModal() {
        modal.classList.remove("show");
    }

    document.getElementById("openServiceModal").addEventListener("click", () => openModal());
    document.getElementById("closeServiceModal").addEventListener("click", closeModal);
    document.getElementById("cancelServiceModal").addEventListener("click", closeModal);
    modal.addEventListener("click", e => { if (e.target === modal) closeModal(); });

    // AI Combo Modal
    document.getElementById("openAiComboModal").addEventListener("click", () => aiComboModal.classList.add("show"));
    document.getElementById("aiComboBannerBtn").addEventListener("click", () => aiComboModal.classList.add("show"));
    document.getElementById("closeAiComboModal").addEventListener("click", () => aiComboModal.classList.remove("show"));
    document.getElementById("closeAiComboBtn").addEventListener("click", () => aiComboModal.classList.remove("show"));
    document.getElementById("publishComboBtn").addEventListener("click", function() {
        alert("Đã áp dụng gói 'Combo Nâng Tầm Nhan Sắc - Glow Up 2026' vào Menu hệ thống thành công!");
        aiComboModal.classList.remove("show");
    });
    aiComboModal.addEventListener("click", e => { if (e.target === aiComboModal) aiComboModal.classList.remove("show"); });

    // Filter
    document.getElementById("serviceSearch").addEventListener("input", renderServices);
    document.getElementById("serviceCategoryFilter").addEventListener("change", renderServices);
    document.getElementById("resetServiceFilter").addEventListener("click", function() {
        document.getElementById("serviceSearch").value = "";
        document.getElementById("serviceCategoryFilter").value = "";
        renderServices();
    });

    // Form submit
    form.addEventListener("submit", function (e) {
        e.preventDefault();

        const editId = document.getElementById("serviceEditId").value;
        const sData = {
            serviceId: editId ? Number(editId) : 0,
            serviceName: document.getElementById("srvName").value.trim(),
            category: document.getElementById("srvCategory").value,
            price: Number(document.getElementById("srvPrice").value) || 0,
            durationMinutes: Number(document.getElementById("srvDuration").value) || 60,
            icon: document.getElementById("srvIcon").value,
            recommendedCosmetics: document.getElementById("srvCosmetics").value.trim(),
            description: document.getElementById("srvDescription").value.trim(),
            status: "Đang cung cấp"
        };

        if (editId) {
            const index = services.findIndex(s => s.serviceId === Number(editId));
            if (index !== -1) {
                sData.serviceCode = services[index].serviceCode;
                sData.aiSuitability = services[index].aiSuitability;
                services[index] = sData;
            }
        } else {
            const newId = services.length ? Math.max(...services.map(s => s.serviceId)) + 1 : 1;
            sData.serviceId = newId;
            sData.serviceCode = "DV" + String(newId).padStart(3, "0");
            sData.aiSuitability = "Phác đồ mới chuẩn Luna Spa.";
            services.unshift(sData);
        }

        closeModal();
        renderServices();
    });

    // Grid button click
    grid.addEventListener("click", function (e) {
        const btn = e.target.closest("button[data-action]");
        if (!btn) return;

        const id = Number(btn.dataset.id);
        const s = services.find(x => x.serviceId === id);
        if (!s) return;

        const action = btn.dataset.action;

        if (action === "edit") {
            openModal(s);
        } else if (action === "delete") {
            if (confirm(`Bạn có chắc muốn xóa dịch vụ "${s.serviceName}" khỏi Menu Spa?`)) {
                services = services.filter(x => x.serviceId !== id);
                renderServices();
            }
        }
    });

    renderServices();
</script>
}