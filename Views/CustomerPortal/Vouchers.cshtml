@model List<GiaoDienSpa.Controllers.CustomerVoucherItem>
@{
    ViewData["Title"] = "Ví Voucher & Đổi Điểm Thưởng Luna Points";
    var rewardPoints = ViewBag.RewardPoints ?? 2850;
}

<div class="customer-vouchers-page">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold mb-1"><i class="fas fa-ticket-alt text-teal me-2"></i> Ví Voucher & Trung Tâm Đổi Điểm Thưởng</h3>
            <p class="text-muted mb-0">Quản lý mã ưu đãi đặc quyền và đổi điểm tích lũy Luna Points lấy quà tặng hấp dẫn</p>
        </div>
        <div>
            <a href="/CustomerPortal/Index" class="btn btn-outline-secondary rounded-pill px-3">
                <i class="fas fa-arrow-left me-1"></i> Cổng Hội Viên
            </a>
        </div>
    </div>

    <!-- Khối số dư điểm thưởng -->
    <div class="card border-0 rounded-4 shadow-sm p-4 mb-4 text-white" style="background: linear-gradient(135deg, #1e293b 0%, #0f172a 100%);">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
            <div>
                <span class="badge bg-warning text-dark fw-bold rounded-pill px-3 py-1 mb-2">HỘI VIÊN DIAMOND</span>
                <h4 class="fw-bold mb-1">Số Dư Điểm Tích Lũy: <span class="text-warning">@rewardPoints Điểm</span></h4>
                <div class="small text-white-50">Tương đương giá trị quy đổi tiền mặt: <strong>285.000 đ</strong> (10 điểm = 1.000 đ)</div>
            </div>
            <div class="d-flex gap-2">
                <button class="btn btn-warning fw-bold rounded-pill px-4 py-2" onclick="redeemPoints('Voucher Giảm 100.000đ Dịch Vụ', 500)">
                    <i class="fas fa-gift me-1"></i> Đổi 500 Điểm Ngay
                </button>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <!-- Danh sách Voucher trong ví -->
        <div class="col-lg-7">
            <div class="card border-0 rounded-4 shadow-sm p-4 bg-white h-100">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="fw-bold mb-0">Voucher Đặc Quyền Của Bạn (@Model.Count(v => !v.IsUsed) khả dụng)</h5>
                    <span class="badge bg-light text-dark border">Cập nhật tự động</span>
                </div>

                <div class="d-flex flex-column gap-3">
                    @foreach (var v in Model)
                    {
                        var borderStyle = v.IsUsed ? "border-secondary bg-light opacity-75" : "border-teal border-dashed bg-white";
                        var tagBadge = v.IsUsed ? "bg-secondary text-white" : "bg-teal text-white";

                        <div class="p-3 rounded-4 border-2 @borderStyle position-relative">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <div>
                                    <span class="badge @tagBadge rounded-pill px-2 py-1 mb-1 small">@v.Tag</span>
                                    <h6 class="fw-bold text-dark mb-1">@v.Title</h6>
                                    <div class="small text-muted">@v.DiscountDesc</div>
                                </div>
                                <div class="text-end">
                                    <span class="badge bg-light text-dark font-monospace border px-2 py-1">@v.Code</span>
                                    <div class="small text-muted mt-1"><i class="fas fa-clock me-1"></i> HSD: @v.ExpiryDate</div>
                                </div>
                            </div>

                            <div class="mt-2 pt-2 border-top d-flex justify-content-between align-items-center">
                                @if (!v.IsUsed)
                                {
                                    <span class="text-success small fw-bold"><i class="fas fa-check-circle me-1"></i> Có hiệu lực</span>
                                    <button class="btn btn-sm btn-outline-teal rounded-pill px-3" onclick="copyVoucher('@v.Code')">
                                        Sao chép mã
                                    </button>
                                }
                                else
                                {
                                    <span class="text-muted small fst-italic">Đã áp dụng cho hóa đơn trước</span>
                                    <button class="btn btn-sm btn-light text-muted rounded-pill px-3" disabled>Đã sử dụng</button>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Trung tâm đổi quà & điểm -->
        <div class="col-lg-5">
            <div class="card border-0 rounded-4 shadow-sm p-4 bg-white h-100">
                <h5 class="fw-bold mb-3"><i class="fas fa-exchange-alt text-teal me-2"></i> Danh Mục Đổi Điểm Thưởng</h5>
                
                <div class="d-flex flex-column gap-3">
                    <div class="p-3 rounded-3 bg-light border d-flex justify-content-between align-items-center">
                        <div>
                            <div class="fw-bold text-dark">Voucher Giảm 100K Mọi Hóa Đơn</div>
                            <div class="small text-muted">Cần: <strong>500 điểm</strong> Luna Points</div>
                        </div>
                        <button class="btn btn-sm btn-outline-teal rounded-pill" onclick="redeemPoints('Voucher Giảm 100K Mọi Hóa Đơn', 500)">
                            Đổi quà
                        </button>
                    </div>

                    <div class="p-3 rounded-3 bg-light border d-flex justify-content-between align-items-center">
                        <div>
                            <div class="fw-bold text-dark">1 Hộp Mặt Nạ Tế Bào Gốc (5 miếng)</div>
                            <div class="small text-muted">Cần: <strong>1.500 điểm</strong> Luna Points</div>
                        </div>
                        <button class="btn btn-sm btn-outline-teal rounded-pill" onclick="redeemPoints('1 Hộp Mặt Nạ Tế Bào Gốc (5 miếng)', 1500)">
                            Đổi quà
                        </button>
                    </div>

                    <div class="p-3 rounded-3 bg-light border d-flex justify-content-between align-items-center">
                        <div>
                            <div class="fw-bold text-dark">01 Buổi Aqua Detox Cấp Ẩm Miễn Phí</div>
                            <div class="small text-muted">Cần: <strong>2.000 điểm</strong> Luna Points</div>
                        </div>
                        <button class="btn btn-sm btn-outline-teal rounded-pill" onclick="redeemPoints('01 Buổi Aqua Detox Cấp Ẩm Miễn Phí', 2000)">
                            Đổi quà
                        </button>
                    </div>
                </div>

                <div class="mt-4 p-3 rounded-3 bg-warning bg-opacity-10 text-dark small border border-warning">
                    <i class="fas fa-info-circle text-warning me-1"></i> <strong>Chính sách tích điểm:</strong> Mỗi 10.000 đ chi tiêu tại Luna Clinic sẽ được tích lũy 1 điểm Luna Point (tỷ lệ hoàn tiền 10% cho thành viên Diamond VIP).
                </div>
            </div>
        </div>
    </div>
</div>

<script>
function copyVoucher(code) {
    navigator.clipboard.writeText(code);
    alert(`Đã sao chép mã ưu đãi [${code}] vào bộ nhớ tạm!`);
}

async function redeemPoints(title, pts) {
    if (!confirm(`Bạn có chắc muốn đổi ${pts} điểm Luna Points để lấy '${title}'?`)) return;

    try {
        const res = await fetch('/CustomerPortal/RedeemPoints', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ rewardTitle: title, pointsNeeded: pts })
        });
        const data = await res.json();
        if (data.success) {
            alert(data.message);
            location.reload();
        } else {
            alert(data.message || 'Lỗi đổi quà');
        }
    } catch(err) {
        console.error(err);
        alert('Lỗi kết nối máy chủ');
    }
}
</script>
