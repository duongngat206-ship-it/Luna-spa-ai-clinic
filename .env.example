# ==============================================================================
# LUNA SPA CLINIC & BEAUTY - ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================
# HƯỚNG DẪN:
# 1. Sao chép file này thành file '.env' cùng thư mục:
#    cp .env.example .env (hoặc copy .env.example .env trên Windows)
# 2. Điền các giá trị bảo mật và cấu hình phù hợp với môi trường của bạn.
# 3. KHÔNG commit file '.env' chứa thông tin thật lên Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CẤU HÌNH SERVER & MÔI TRƯỜNG CHẠY (ASP.NET Core)
# ------------------------------------------------------------------------------
# Môi trường chạy: Development | Staging | Production
ASPNETCORE_ENVIRONMENT=Development

# Cổng và địa chỉ URL lắng nghe của ứng dụng
ASPNETCORE_URLS=https://localhost:7001;http://localhost:5000
ASPNETCORE_HTTPS_PORT=7001

# Thông tin cơ bản về Spa
APP_NAME="Luna Spa Clinic & Beauty"
APP_URL=https://localhost:7001
SPA_HOTLINE="1900 888 999"
SPA_ADDRESS="123 Nguyễn Huệ, Phường Bến Nghé, Quận 1, TP. Hồ Chí Minh"

# ------------------------------------------------------------------------------
# 2. CẤU HÌNH CƠ SỞ DỮ LIỆU (DATABASE CONNECTION)
# ------------------------------------------------------------------------------
# Chuỗi kết nối trực tiếp tương thích cấu hình ASP.NET Core (ConnectionStrings:DefaultConnection)
ConnectionStrings__DefaultConnection="Server=localhost,1433;Database=LunaSpaDb;User Id=sa;Password=YourStrongPassword123!;TrustServerCertificate=True;"

# Cấu hình phân tách nếu dùng Container / Microservice / CI-CD
DB_PROVIDER=sqlserver
DB_HOST=localhost
DB_PORT=1433
DB_NAME=LunaSpaDb
DB_USER=sa
DB_PASSWORD=YourStrongPassword123!

# ------------------------------------------------------------------------------
# 3. BẢO MẬT, MÃ HÓA & TOKEN (JWT & SECURITY)
# ------------------------------------------------------------------------------
# Khóa bí mật JWT (tối thiểu 32 ký tự, bắt buộc đổi khi triển khai Production)
JWT_SECRET=LunaSpa_Super_Secret_Key_Change_Me_In_Production_2026_XYZ!
JWT_ISSUER=LunaSpaClinic
JWT_AUDIENCE=LunaSpaUsers
JWT_EXPIRES_MINUTES=120
SESSION_TIMEOUT_MINUTES=60

# ------------------------------------------------------------------------------
# 4. TÀI KHOẢN QUẢN TRỊ VIÊN MẶC ĐỊNH (ADMIN DEFAULT CREDENTIALS)
# ------------------------------------------------------------------------------
ADMIN_FULLNAME="Nguyễn Quản Trị"
ADMIN_EMAIL=admin@lunaspa.vn
ADMIN_PASSWORD=AdminSecure@2026!
ADMIN_PHONE="0988 888 999"

# ------------------------------------------------------------------------------
# 5. TÍCH HỢP TRÍ TUỆ NHÂN TẠO AI (SKIN DIAGNOSIS & CONSULTATION)
# Dành cho module AI khám da, đề xuất phác đồ & phân tích doanh thu thông minh
# ------------------------------------------------------------------------------
# Nhà cung cấp AI: gemini | openai
AI_PROVIDER=gemini

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# OpenAI API (Tùy chọn)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# ------------------------------------------------------------------------------
# 6. CỔNG THANH TOÁN & NGÂN HÀNG QR CODE (INVOICE & PAYMENTS)
# ------------------------------------------------------------------------------
# Cấu hình thanh toán chuyển khoản nhanh VietQR
VIETQR_BANK_ID=970407
VIETQR_ACCOUNT_NO=19036868686868
VIETQR_ACCOUNT_NAME="LUNA SPA CLINIC"

# Cổng thanh toán VNPAY
VNPAY_TMN_CODE=your_vnpay_tmn_code
VNPAY_HASH_SECRET=your_vnpay_hash_secret
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=https://localhost:7001/Invoices/PaymentCallback

# Cổng thanh toán MoMo (Tùy chọn)
MOMO_PARTNER_CODE=your_momo_partner_code
MOMO_ACCESS_KEY=your_momo_access_key
MOMO_SECRET_KEY=your_momo_secret_key
MOMO_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api/create

# ------------------------------------------------------------------------------
# 7. THÔNG BÁO TỰ ĐỘNG: EMAIL & SMS NHẮC LỊCH HẸN (APPOINTMENT REMINDERS)
# ------------------------------------------------------------------------------
# Cấu hình gửi Email qua SMTP (Gmail, SendGrid, Amazon SES)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_ENABLE_SSL=true
SMTP_USER=cskh@lunaspa.vn
SMTP_PASS=your_app_specific_password_here
SMTP_FROM_NAME="Luna Spa & Clinic"

# Cấu hình gửi tin nhắn SMS Brandname nhắc hẹn
SMS_PROVIDER=esms
SMS_API_KEY=your_sms_api_key_here
SMS_SECRET_KEY=your_sms_secret_key_here
SMS_BRANDNAME=LUNA_SPA

# ------------------------------------------------------------------------------
# 8. CẤU HÌNH GHI LOG & THEO DÕI HỆ THỐNG (LOGGING)
# ------------------------------------------------------------------------------
Logging__LogLevel__Default=Information
Logging__LogLevel__Microsoft_AspNetCore=Warning
Logging__LogLevel__System=Error
