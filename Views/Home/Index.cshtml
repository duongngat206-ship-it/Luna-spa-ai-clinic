@{
    ViewData["Title"] = "LUNA SPA & CLINIC - Chăm sóc sắc đẹp chuẩn Quốc tế tích hợp AI";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var currentUserName = ViewBag.CurrentUserName as string;
    var currentUserRole = ViewBag.CurrentUserRole as string;
    var currentUserRoleTitle = ViewBag.CurrentUserRoleTitle as string;
    var currentUserAvatar = ViewBag.CurrentUserAvatar as string ?? "AD";
    bool isLoggedIn = !string.IsNullOrEmpty(currentUserName);
}

<div class="public-portal">

    <!-- HERO SECTION SANG TRỌNG -->
    <section class="portal-hero">
        <div class="portal-hero-container">
            <div class="portal-hero-content">
                <div class="portal-badge-glow">
                    <span class="portal-badge-dot"></span>
                    <span>TIÊN PHONG CÔNG NGHỆ LÀM ĐẸP TÍCH HỢP TRÍ TUỆ NHÂN TẠO AI 2026</span>
                </div>

                <h1 class="portal-hero-title">
                    Nâng Tầm Vẻ Đẹp Hoàn Mỹ Cùng <span class="portal-gradient-text">Trí Tuệ Nhân Tạo AI</span>
                </h1>

                <p class="portal-hero-desc">
                    Hệ thống quản lý Spa & Viện thẩm mỹ chuẩn 5 sao quốc tế. Ứng dụng công nghệ AI chẩn đoán quang phổ đa tầng da, cá nhân hóa phác đồ Laser Pico, Nâng cơ Hifu và điều hành trải nghiệm khách hàng toàn diện.
                </p>

                <div class="portal-hero-actions">
                    <a href="#aiExperienceSection" class="portal-btn-primary">
                        <span>✨</span> Trải nghiệm Soi Da AI Miễn Phí
                    </a>
                    <a href="#servicesSection" class="portal-btn-secondary">
                        <span>✦</span> Khám phá Dịch vụ Thẩm mỹ
                    </a>
                    @if (!isLoggedIn)
                    {
                        <button type="button" class="portal-btn-ghost open-auth-modal-btn" data-mode="login">
                            <span>🔑</span> Đăng nhập Hệ thống
                        </button>
                    }
                    else
                    {
                        <a asp-controller="Home" asp-action="Dashboard" class="portal-btn-ghost">
                            <span>▦</span> Vào Bảng điều khiển Quản trị
                        </a>
                    }
                </div>

                @if (!isLoggedIn)
                {
                    <div class="portal-hero-quick-roles mt-3" style="display: flex; align-items: center; gap: 8px; flex-wrap: wrap;">
                        <span style="font-size: 12px; color: #f3d2e2; font-weight: 600;">⚡ Đăng nhập nhanh 1-Click:</span>
                        <button type="button" class="btn btn-sm btn-outline-light rounded-pill px-3 py-1 btn-demo-quick" data-role="Admin" style="font-size: 11.5px; border-color: rgba(255,255,255,0.4);">
                            🛡️ Quản trị viên
                        </button>
                        <button type="button" class="btn btn-sm btn-outline-light rounded-pill px-3 py-1 btn-demo-quick" data-role="Doctor" style="font-size: 11.5px; border-color: rgba(255,255,255,0.4);">
                            🩺 Bác sĩ
                        </button>
                        <button type="button" class="btn btn-sm btn-outline-light rounded-pill px-3 py-1 btn-demo-quick" data-role="Staff" style="font-size: 11.5px; border-color: rgba(255,255,255,0.4);">
                            💆 Nhân viên
                        </button>
                        <button type="button" class="btn btn-sm btn-outline-light rounded-pill px-3 py-1 btn-demo-quick" data-role="Customer" style="font-size: 11.5px; border-color: rgba(255,255,255,0.4);">
                            👤 Khách hàng
                        </button>
                    </div>
                }

                <div class="portal-stats-row">
                    <div class="portal-stat-item">
                        <strong>99.4%</strong>
                        <span>Độ chính xác chẩn đoán AI</span>
                    </div>
                    <div class="portal-stat-divider"></div>
                    <div class="portal-stat-item">
                        <strong>18.500+</strong>
                        <span>Khách hàng phục hồi da</span>
                    </div>
                    <div class="portal-stat-divider"></div>
                    <div class="portal-stat-item">
                        <strong>100%</strong>
                        <span>Bác sĩ chuyên khoa Da liễu</span>
                    </div>
                </div>
            </div>

            <div class="portal-hero-visual">
                <div class="portal-image-frame">
                    <img src="/images/hero-banner.jpg" alt="LUNA SPA AI Clinic & Beauty" class="portal-hero-img" />
                    
                    <!-- FLOATING AI CARD 1 -->
                    <div class="floating-ai-card card-top-right">
                        <div class="floating-ai-icon">✦</div>
                        <div>
                            <strong>AI Skin Health Score</strong>
                            <div class="floating-ai-bar">
                                <div class="floating-ai-fill" style="width: 92%;"></div>
                            </div>
                            <small>Độ phục hồi tế bào: 92% (Tối ưu)</small>
                        </div>
                    </div>

                    <!-- FLOATING AI CARD 2 -->
                    <div class="floating-ai-card card-bottom-left">
                        <div class="floating-ai-status-dot"></div>
                        <div>
                            <strong>Phòng Laser Pico & Hifu</strong>
                            <small>Đang phục vụ • Công nghệ chuẩn FDA</small>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- SECTION 3 ĐỘT PHÁ CÔNG NGHỆ AI TRONG QUẢN LÝ & CHĂM SÓC DA -->
    <section class="portal-section" id="aiHighlightsSection">
        <div class="portal-container">
            <div class="portal-section-header">
                <span class="portal-sub-title">ĐỈNH CAO CÔNG NGHỆ 2026</span>
                <h2>Hệ Thống Trí Tuệ Nhân Tạo AI Độc Quyền Tại LUNA SPA</h2>
                <p>Khác biệt vượt trội từ khâu chẩn đoán lâm sàng, tối ưu hóa năng lượng trị liệu cho đến quản lý vận hành tự động.</p>
            </div>

            <div class="portal-features-grid">
                <!-- CARD 1 -->
                <div class="portal-feature-card">
                    <div class="feature-img-wrapper">
                        <img src="/images/ai-scan.jpg" alt="AI Dermal Diagnostic Scanner" />
                        <span class="feature-badge">AI SCANNER 3D</span>
                    </div>
                    <div class="feature-content">
                        <h3>1. Chẩn Đoán Biểu Bì Quang Phổ AI 3D</h3>
                        <p>
                            Quét 8 tầng biểu bì chỉ trong 30 giây. Phát hiện chính xác chân nám sâu, mật độ vi khuẩn C.acnes, độ phân mảnh collagen và tổn thương tia UV chưa nhìn thấy bằng mắt thường.
                        </p>
                        <ul class="feature-bullet-list">
                            <li>✓ Bản đồ nhiệt độ ẩm & bã nhờn vùng chữ T</li>
                            <li>✓ Chấm điểm sức khỏe làn da theo thang đo y khoa</li>
                            <li>✓ Lưu trữ hồ sơ điện tử theo dõi tiến trình qua từng tuần</li>
                        </ul>
                    </div>
                </div>

                <!-- CARD 2 -->
                <div class="portal-feature-card">
                    <div class="feature-img-wrapper">
                        <img src="/images/laser-pico.jpg" alt="Laser Pico Pro AI Protocol" />
                        <span class="feature-badge">AI PROTOCOL</span>
                    </div>
                    <div class="feature-content">
                        <h3>2. Phác Đồ Trị Liệu Cá Nhân Hóa Chuẩn Xác</h3>
                        <p>
                            AI tính toán chuẩn xác bước sóng (1064nm / 532nm), mật độ xung mili-joule và thời gian chiếu sáng phù hợp cho từng cơ địa da, giúp rút ngắn 50% thời gian điều trị.
                        </p>
                        <ul class="feature-bullet-list">
                            <li>✓ Trẻ hóa màng đáy da, tăng sinh collagen tự thân</li>
                            <li>✓ Xóa mờ nám, tàn nhang không đau rát, không nghỉ dưỡng</li>
                            <li>✓ Bác sĩ chuyên khoa trực tiếp điều chỉnh và giám sát</li>
                        </ul>
                    </div>
                </div>

                <!-- CARD 3 -->
                <div class="portal-feature-card">
                    <div class="feature-img-wrapper">
                        <img src="/images/aqua-detox.jpg" alt="Aqua Detox & AI Care Tracking" />
                        <span class="feature-badge">AI RECOVERY</span>
                    </div>
                    <div class="feature-content">
                        <h3>3. Chăm Sóc & Dự Báo Phục Hồi Tự Động</h3>
                        <p>
                            Sau liệu trình, trợ lý AI tự động lập thời khóa biểu skincare buổi sáng/tối, gửi tin nhắn SMS nhắc lịch chăm sóc và cảnh báo thời điểm cần thoa kem chống nắng bảo vệ.
                        </p>
                        <ul class="feature-bullet-list">
                            <li>✓ Đề xuất mỹ phẩm tương thích sinh học với làn da</li>
                            <li>✓ Tự động thông báo lịch hẹn tiếp theo qua Zalo/SMS</li>
                            <li>✓ Tương tác hỗ trợ giải đáp thắc mắc 24/7</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- TRẢI NGHIỆM SOI DA AI TRỰC TIẾP TRÊN TRANG CHỦ -->
    <section class="portal-section portal-ai-widget-section" id="aiExperienceSection">
        <div class="portal-container">
            <div class="portal-ai-widget">
                <div class="portal-ai-widget-left">
                    <span class="portal-badge-glow">TRẢI NGHIỆM MIỄN PHÍ</span>
                    <h2>Khám Phá Tình Trạng Làn Da Cùng Trợ Lý LUNA AI</h2>
                    <p>
                        Chọn các thông tin cơ bản về độ tuổi và vấn đề làn da bạn đang quan tâm nhất. Thuật toán AI của chúng tôi sẽ phân tích sơ bộ và gợi ý phác đồ phù hợp ngay lập tức!
                    </p>

                    <div class="portal-interactive-form">
                        <div class="form-row-portal">
                            <div class="form-group-portal">
                                <label>Độ tuổi của bạn:</label>
                                <select id="aiQuickAge" class="portal-select">
                                    <option value="25">18 - 25 tuổi (Trẻ, dễ mụn dầu)</option>
                                    <option value="32" selected>26 - 35 tuổi (Chớm lão hóa, lỗ chân lông)</option>
                                    <option value="42">36 - 45 tuổi (Nám mảng, rãnh cười)</option>
                                    <option value="52">Trên 45 tuổi (Chùng nhão cơ, lão hóa sâu)</option>
                                </select>
                            </div>
                            <div class="form-group-portal">
                                <label>Loại da hiện tại:</label>
                                <select id="aiQuickSkinType" class="portal-select">
                                    <option value="Da dầu nhờn mụn">Da dầu nhờn, nhiều mụn</option>
                                    <option value="Da hỗn hợp thiên dầu" selected>Da hỗn hợp thiên dầu</option>
                                    <option value="Da khô mất nước">Da khô bong tróc, thiếu ẩm</option>
                                    <option value="Da nhạy cảm mỏng manh">Da nhạy cảm, dễ ửng đỏ</option>
                                </select>
                            </div>
                        </div>

                        <div class="form-group-portal">
                            <label>Vấn đề bạn quan tâm cải thiện nhất:</label>
                            <div class="portal-tag-selector" id="aiConcernSelector">
                                <button type="button" class="portal-tag-btn active" data-val="Lỗ chân lông to & Dầu thừa">Lỗ chân lông & Dầu</button>
                                <button type="button" class="portal-tag-btn" data-val="Nám mảng & Tàn nhang">Nám & Tàn nhang</button>
                                <button type="button" class="portal-tag-btn" data-val="Mụn viêm & Thâm mụn">Mụn & Thâm</button>
                                <button type="button" class="portal-tag-btn" data-val="Nếp nhăn & Chùng nhão">Chùng nhão & Nếp nhăn</button>
                            </div>
                        </div>

                        <button type="button" class="portal-btn-primary" id="btnRunAiDiagnosis">
                            <span>✦</span> Bắt đầu Phân Tích Da Bằng AI
                        </button>
                    </div>
                </div>

                <div class="portal-ai-widget-right">
                    <div class="ai-diagnosis-result-card" id="aiResultBox">
                        <div class="result-header">
                            <div class="result-avatar-pulse">AI</div>
                            <div>
                                <strong>KẾT QUẢ PHÂN TÍCH QUANG PHỔ AI</strong>
                                <small id="resultTimestamp">Thời gian: Vừa cập nhật</small>
                            </div>
                            <div class="result-score-badge" id="resultScore">78 / 100</div>
                        </div>

                        <div class="result-body">
                            <div class="result-diagnosis-text" id="resultText">
                                Hàng rào bảo vệ da tương đối ổn định nhưng thiếu ẩm tầng sâu dẫn đến tăng tiết bã nhờn bù trừ. Vùng chữ T có dấu hiệu sợi bã nhờn và lỗ chân lông giãn nở nhẹ.
                            </div>

                            <div class="result-recommendation">
                                <strong>✦ Phác đồ điều trị khuyến nghị:</strong>
                                <p id="resultService">Chăm sóc da chuyên sâu Aqua Detox + Điện di Tế bào gốc Tái sinh</p>
                            </div>

                            <div class="result-cosmetics">
                                <strong>✦ Bộ dưỡng phục hồi phù hợp:</strong>
                                <p id="resultCosmetic">Serum B5 HA Intensifier + Gel Rửa Mặt BHA 1% + Kem chống nắng Phổ rộng</p>
                            </div>
                        </div>

                        <div class="result-footer">
                            <button type="button" class="portal-btn-primary" id="btnBookFromAiResult" style="width: 100%; justify-content: center;">
                                <span>📅</span> Đặt lịch Trị liệu Phác đồ này
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- DANH MỤC DỊCH VỤ THẨM MỸ NỔI BẬT -->
    <section class="portal-section" id="servicesSection">
        <div class="portal-container">
            <div class="portal-section-header">
                <span class="portal-sub-title">MENU DỊCH VỤ CAO CẤP</span>
                <h2>Phác Đồ Làm Đẹp & Trị Liệu Da Chuyên Sâu</h2>
                <p>Mỗi dịch vụ đều được bảo đảm bằng cam kết chất lượng, máy móc chuẩn Y khoa và đội ngũ bác sĩ uy tín.</p>
            </div>

            <div class="portal-services-grid">
                <!-- DỊCH VỤ 1 -->
                <div class="service-card-portal">
                    <div class="service-card-badge">HOT • CÔNG NGHỆ CAO</div>
                    <div class="service-card-img" style="background-image: url('/images/laser-pico.jpg');"></div>
                    <div class="service-card-body">
                        <h3>Trẻ Hóa Da Laser Pico Pro</h3>
                        <p>Ứng dụng bước sóng Pico giây phá vỡ sắc tố melanin thành hạt siêu nhỏ, kích thích mạng lưới collagen tự thân.</p>
                        <div class="service-card-meta">
                            <span>⏱ 75 phút</span>
                            <span>✦ Bác sĩ trực tiếp làm</span>
                        </div>
                        <div class="service-card-pricing">
                            <div class="price-val">2.500.000 đ</div>
                            <button type="button" class="btn-book-service" data-service="Trẻ Hóa Da Laser Pico Pro">Đặt lịch</button>
                        </div>
                    </div>
                </div>

                <!-- DỊCH VỤ 2 -->
                <div class="service-card-portal">
                    <div class="service-card-badge">NÂNG CƠ TRẺ HÓA</div>
                    <div class="service-card-img" style="background-image: url('/images/hero-banner.jpg');"></div>
                    <div class="service-card-body">
                        <h3>Nâng Cơ Hifu Ultra Collagen</h3>
                        <p>Tác động sóng siêu âm hội tụ vi điểm tới lớp cân cơ SMAS, định hình đường viền hàm thon gọn và xóa nếp nhăn trán.</p>
                        <div class="service-card-meta">
                            <span>⏱ 90 phút</span>
                            <span>✦ Hiệu quả duy trì 18 tháng</span>
                        </div>
                        <div class="service-card-pricing">
                            <div class="price-val">4.500.000 đ</div>
                            <button type="button" class="btn-book-service" data-service="Nâng Cơ Hifu Ultra Collagen">Đặt lịch</button>
                        </div>
                    </div>
                </div>

                <!-- DỊCH VỤ 3 -->
                <div class="service-card-portal">
                    <div class="service-card-badge">DETOX & CẤP NƯỚC</div>
                    <div class="service-card-img" style="background-image: url('/images/aqua-detox.jpg');"></div>
                    <div class="service-card-body">
                        <h3>Chăm Sóc Da Aqua Detox Chuyên Sâu</h3>
                        <p>Lực hút xoáy chân không Hydro Peel hút sạch bụi mịn bã nhờn, kết hợp điện di tinh chất HA B5 phục hồi da tức thì.</p>
                        <div class="service-card-meta">
                            <span>⏱ 60 phút</span>
                            <span>✦ Căng bóng ngậm nước</span>
                        </div>
                        <div class="service-card-pricing">
                            <div class="price-val">850.000 đ</div>
                            <button type="button" class="btn-book-service" data-service="Chăm Sóc Da Aqua Detox Chuyên Sâu">Đặt lịch</button>
                        </div>
                    </div>
                </div>

                <!-- DỊCH VỤ 4 -->
                <div class="service-card-portal">
                    <div class="service-card-badge">TRẮNG SÁNG VI ĐIỂM</div>
                    <div class="service-card-img" style="background-image: url('/images/ai-scan.jpg');"></div>
                    <div class="service-card-body">
                        <h3>Cấy Vi Điểm Bio-Glutathione</h3>
                        <p>Đưa phức hợp Glutathione và Tế bào gốc tái sinh trực tiếp vào màng đáy biểu bì, ức chế enzyme Tyrosinase tạo sắc tố sạm.</p>
                        <div class="service-card-meta">
                            <span>⏱ 75 phút</span>
                            <span>✦ Bật 2-3 tone da khỏe</span>
                        </div>
                        <div class="service-card-pricing">
                            <div class="price-val">3.200.000 đ</div>
                            <button type="button" class="btn-book-service" data-service="Cấy Vi Điểm Bio-Glutathione">Đặt lịch</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- SECTION ĐỘI NGŨ BÁC SĨ & CHUYÊN GIA -->
    <section class="portal-section portal-expert-section">
        <div class="portal-container">
            <div class="portal-section-header">
                <span class="portal-sub-title">CHUYÊN GIA TẬN TÂM</span>
                <h2>Đội Ngũ Bác Sĩ & Kỹ Thuật Viên Hàng Đầu</h2>
                <p>Được đào tạo bài bản từ các trường Y khoa danh tiếng, có chứng chỉ hành nghề thẩm mỹ công nghệ cao chuẩn quốc tế.</p>
            </div>

            <div class="portal-experts-grid">
                <div class="expert-card">
                    <div class="expert-avatar" style="background: linear-gradient(135deg, #a76d8e, #d88a2c);">HY</div>
                    <h3>Bác sĩ Lê Hoàng Yến</h3>
                    <p class="expert-role">Bác sĩ Chuyên khoa Da liễu & Laser Thẩm mỹ</p>
                    <p class="expert-desc">15 năm kinh nghiệm điều trị sạm nám và trẻ hóa da công nghệ cao. Tác giả nhiều nghiên cứu ứng dụng AI trong da liễu.</p>
                    <span class="expert-tag">Bác sĩ phụ trách chuyên môn</span>
                </div>

                <div class="expert-card">
                    <div class="expert-avatar" style="background: linear-gradient(135deg, #2b7bb9, #3da58a);">TT</div>
                    <h3>Nguyễn Thu Trang</h3>
                    <p class="expert-role">Kỹ thuật viên Trưởng Trị liệu Spa</p>
                    <p class="expert-desc">10 năm kinh nghiệm liệu pháp massage bấm huyệt Nhật Bản và chăm sóc phục hồi da mụn nhạy cảm.</p>
                    <span class="expert-tag">KTV Trưởng đào tạo dịch vụ</span>
                </div>

                <div class="expert-card">
                    <div class="expert-avatar" style="background: linear-gradient(135deg, #7c3aed, #a855f7);">QT</div>
                    <h3>Nguyễn Quản Trị</h3>
                    <p class="expert-role">Giám đốc Điều hành LUNA SPA</p>
                    <p class="expert-desc">Cam kết mang lại chuẩn mực phục vụ 5 sao, môi trường vô trùng tuyệt đối và ứng dụng chuyển đổi số toàn diện.</p>
                    <span class="expert-tag">Quản trị viên tối cao</span>
                </div>
            </div>
        </div>
    </section>

    <!-- FORM ĐẶT HẸN TRỰC TUYẾN NHANH -->
    <section class="portal-section portal-booking-section" id="bookingSection">
        <div class="portal-container">
            <div class="portal-booking-card">
                <div class="portal-booking-info">
                    <span class="portal-badge-glow">ĐẶT LỊCH ƯU TIÊN</span>
